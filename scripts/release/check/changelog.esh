set -e

assert [ "$#" -eq 2 ] "usage: changelog.esh <generated-changelog> <version>"
CHANGELOG="$1"
VERSION="$2"

assert [ -f "$CHANGELOG" ] "generated changelog is missing: $CHANGELOG"
assert "grep -Eq '^# Changelog\s*$' '$CHANGELOG'" -- "${CHANGELOG} is missing the root Changelog heading"
if ! echo "$VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'; then
  echo "release version is not supported: $VERSION" >&2
  exit 1
fi
ESCAPED_VERSION=$(str -r . '\.' "$VERSION")
assert "grep -Eq '^## \[v${ESCAPED_VERSION}\]$' '$CHANGELOG'" -- "${CHANGELOG} is missing the generated section for v${VERSION}"

echo "Verified generated changelog section for v$VERSION"
