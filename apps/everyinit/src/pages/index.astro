---
import SiteLayout from "../layouts/SiteLayout.astro";
import { renderHighlightedCode } from "../lib/render-doc";

const heroCode = `#!evin/v1
workspace:
  name: storefront
  execution: linear

stages: [Check, Test]

tasks:
  lint:
    stage: Check
    run: npm run lint

  test:
    stage: Test
    needs: [lint]
    run: npm test`;

const principles = [
  { number: "01", title: "One place for project work", text: "Describe the jobs around your code once. Evin resolves the order, dependencies, and shared context before anything runs." },
  { number: "02", title: "The same checks everywhere", text: "Run a task from your terminal, a Git hook, your editor, or CI. Keep the command and its result tied to the workspace." },
  { number: "03", title: "Automation that stays readable", text: "Use declarative Flow for the common path and ESH when a task needs real control flow, data, or cleanup." },
];

const integrations = ["Terminal", "Git hooks", "IDE integrations", "CI", "Evin actions"];

const navigation = [
  {
    title: "Tools",
    links: [
      { title: "Evin", description: "Workspace tasks and project automation.", href: "https://docs.everyinit.dev/book/installation", icon: "workflow" },
      { title: "ESH", description: "Write scripts with data and control flow.", href: "https://docs.everyinit.dev/book/esh", icon: "terminal" },
      { title: "IDE integrations", description: "Connect editors through language services.", href: "https://docs.everyinit.dev/book/esh/editor-integration", icon: "window" },
      { title: "Web integrations", description: "Build docs sites with Everyinit for the web.", href: "https://github.com/dukasn/everyinit/tree/main/packages/everyinit", icon: "globe" },
    ],
  },
  {
    title: "Resources",
    links: [
      { title: "Documentation", description: "Guides and technical reference.", href: "https://docs.everyinit.dev/", icon: "book" },
      { title: "How it works", description: "See how Evin organizes project work.", href: "#workflow", icon: "route" },
      { title: "Integrations", description: "Explore the connected Everyinit projects.", href: "#integrations", icon: "layers" },
      { title: "Source code", description: "Browse the project on GitHub.", href: "https://github.com/dukasn/everyinit", icon: "code" },
    ],
  },
  {
    title: "Help",
    links: [
      { title: "Get started", description: "Install Evin and create your first workflow.", href: "https://docs.everyinit.dev/book/installation", icon: "play" },
      { title: "Contribute", description: "Read the development and contribution guides.", href: "https://docs.everyinit.dev/contributing/development", icon: "people" },
      { title: "Ask or report an issue", description: "Get help and share a bug report.", href: "https://github.com/dukasn/everyinit/issues", icon: "message" },
    ],
  },
];

const navigationIconPaths = {
  workflow: "M4 6h6v5H4z M14 13h6v5h-6z M10 8.5h4v7h-4 M12 15.5v-7",
  terminal: "M4 5h16v14H4z M7 9l3 3-3 3 M12 15h4",
  window: "M4 5h16v14H4z M4 9h16 M8 5v4",
  globe: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M3.5 12h17 M12 3c2.2 2.4 3.2 5.4 3.2 9S14.2 18.6 12 21c-2.2-2.4-3.2-5.4-3.2-9S9.8 5.4 12 3z",
  book: "M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 0 4 22z M4 5.5v14A2.5 2.5 0 0 1 6.5 17H20 M8 7h8",
  route: "M6 5a2 2 0 1 0 0 .01z M18 19a2 2 0 1 0 0 .01z M6 7v5a2 2 0 0 0 2 2h8a2 2 0 0 1 2 2v1 M14 5a2 2 0 1 0 0 .01z M14 7v2",
  layers: "m12 3 9 5-9 5-9-5 9-5z M3 12l9 5 9-5 M3 16l9 5 9-5",
  code: "m8 8-4 4 4 4 M16 8l4 4-4 4 M14 5l-4 14",
  play: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M10 8l6 4-6 4z",
  people: "M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M20 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75",
  message: "M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z",
};

const projects = [
  {
    number: "02",
    name: "ESH",
    label: "SCRIPTING",
    description: "Structured scripts for branching, data, process control, and cleanup.",
    href: "https://docs.everyinit.dev/book/esh",
    link: "Read the ESH guide",
  },
  {
    number: "03",
    name: "IDE integrations",
    label: "STANDARD LSP · SHARED SCHEMAS",
    description: "Connect LSP-capable editors to Evin and ESH language services. The VS Code extension packages syntax support, diagnostics, and workspace task access.",
    href: "https://docs.everyinit.dev/book/esh/editor-integration",
    link: "Connect an IDE",
  },
  {
    number: "04",
    name: "Everyinit for the web",
    label: "NPM PACKAGE · IN DEVELOPMENT",
    description: "Framework-neutral docs data with a Vite integration, built for localized and versioned routes.",
    href: "https://github.com/dukasn/everyinit/tree/main/packages/everyinit",
    link: "Explore package development",
  },
];
---

<SiteLayout>
  <header class="relative z-40 mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-5 sm:px-8 lg:px-12">
    <a href="/" class="group flex items-center gap-3 font-semibold tracking-tight" aria-label="Everyinit home">
      <span class="grid size-10 place-items-center rounded-xl bg-ink text-lime shadow-sm">
        <span class="brand-mark size-6 motion-safe:transition-transform motion-safe:duration-300 group-hover:rotate-6 group-hover:scale-105" aria-hidden="true"></span>
      </span>
      <span class="text-lg">everyinit</span>
    </a>
    <nav class="hidden items-center gap-1 text-sm text-moss lg:flex xl:gap-2" aria-label="Main navigation">
      {navigation.map((menu) => <details data-nav-menu class="home-nav-menu group relative">
        <summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-full px-3 py-2.5 font-medium transition hover:bg-[#e7e9df] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-moss [&::-webkit-details-marker]:hidden">
          {menu.title}<svg class="home-nav-chevron size-3.5 text-moss transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </summary>
        <div class:list={["absolute top-full z-50 w-[min(22rem,calc(100vw-2rem))] pt-3", { "left-0": menu.title !== "Help", "right-0": menu.title === "Help" }]}>
          <div class="rounded-2xl border border-[#d5dccf] bg-surface p-2 shadow-[0_22px_55px_-28px_rgba(23,33,26,.45)]">
            <ul class="grid gap-1">
              {menu.links.map((link) => <li>
                <a class="group/link grid grid-cols-[2.5rem_1fr_auto] items-center gap-3 rounded-xl px-3 py-2.5 transition hover:bg-[#e9eee5] focus-visible:bg-[#e9eee5] focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-moss" href={link.href}>
                  <span class="grid size-10 place-items-center rounded-xl bg-[#edf1e9] text-moss transition group-hover/link:bg-white"><svg class="size-[18px]" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={navigationIconPaths[link.icon as keyof typeof navigationIconPaths]} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                  <span class="min-w-0"><span class="block text-sm font-semibold text-ink">{link.title}</span><span class="mt-1 block text-xs leading-5 text-[#667264]">{link.description}</span></span>
                  <span class="text-moss opacity-0 transition group-hover/link:translate-x-0.5 group-hover/link:opacity-100 group-focus-visible/link:opacity-100" aria-hidden="true">↗</span>
                </a>
              </li>)}
            </ul>
          </div>
        </div>
      </details>)}
    </nav>
    <a href="https://docs.everyinit.dev/book/installation" class="hidden shrink-0 rounded-full bg-ink px-5 py-3 text-sm font-medium text-paper transition hover:bg-moss active:scale-[.98] lg:inline-flex">
      Get started <span class="ml-2" aria-hidden="true">↗</span>
    </a>
    <details data-nav-menu class="home-mobile-nav group relative lg:hidden">
      <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-full border border-line text-ink transition hover:bg-[#e7e9df] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-moss [&::-webkit-details-marker]:hidden">
        <span class="grid gap-[5px]" aria-hidden="true"><span class="h-0.5 w-4 rounded-full bg-current transition group-open:translate-y-[3.5px] group-open:rotate-45"></span><span class="h-0.5 w-4 rounded-full bg-current transition group-open:-translate-y-[3.5px] group-open:-rotate-45"></span></span>
        <span class="sr-only">Menu</span>
      </summary>
      <nav aria-label="Mobile navigation" class="fixed left-1/2 top-[5.75rem] z-[60] max-h-[calc(100dvh-7rem)] w-[min(48rem,calc(100vw-3rem))] -translate-x-1/2 overflow-y-auto overscroll-contain rounded-[1.75rem] border border-[#d5dccf] bg-surface p-5 shadow-[0_28px_70px_-36px_rgba(23,33,26,.5)] sm:p-6">
        <div class="mb-1 flex items-center justify-between gap-4 border-b border-[#d5dccf] px-1 pb-5 sm:px-2">
          <span class="text-[10px] font-semibold uppercase tracking-[.18em] text-moss sm:text-xs">Explore Everyinit</span>
          <a class="inline-flex shrink-0 items-center gap-2 rounded-full bg-ink px-4 py-3 text-sm font-semibold text-paper transition hover:bg-moss" href="https://docs.everyinit.dev/book/installation">Get started <span class="text-lime" aria-hidden="true">↗</span></a>
        </div>
        {navigation.map((menu) => <details class="home-mobile-nav-group border-b border-[#d5dccf] last:border-b-0">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 text-[clamp(1.125rem,2vw,1.25rem)] font-semibold tracking-[-.025em] text-ink [&::-webkit-details-marker]:hidden sm:py-3.5">{menu.title}<svg class="home-nav-chevron size-4 shrink-0 text-moss transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
          <ul class="grid gap-1 pb-4 sm:grid-cols-2">
            {menu.links.map((link) => <li><a class="group/link grid grid-cols-[2.25rem_1fr] items-center gap-3 rounded-xl px-2 py-2.5 transition hover:bg-[#e9eee5] focus-visible:bg-[#e9eee5] focus-visible:outline-2 focus-visible:outline-moss" href={link.href}><span class="grid size-9 place-items-center rounded-lg bg-[#edf1e9] text-moss transition group-hover/link:bg-white"><svg class="size-[17px]" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={navigationIconPaths[link.icon as keyof typeof navigationIconPaths]} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="min-w-0"><span class="block text-sm font-semibold text-ink">{link.title}</span><span class="mt-0.5 block text-xs leading-5 text-[#667264]">{link.description}</span></span></a></li>)}
          </ul>
        </details>)}
      </nav>
    </details>
  </header>

  <script>
    const header = document.querySelector("header");
    const navMenus = [...(header?.querySelectorAll<HTMLDetailsElement>("details[data-nav-menu]") ?? [])];

    navMenus.forEach((menu) => menu.addEventListener("toggle", () => {
      if (menu.open) {
        navMenus.filter((other) => other !== menu).forEach((other) => { other.open = false; });
      } else {
        menu.querySelectorAll("details").forEach((nested) => { nested.open = false; });
      }
    }));

    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !header?.contains(event.target)) {
        navMenus.forEach((menu) => { menu.open = false; });
      }
    });

    header?.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("nav a")) {
        navMenus.forEach((menu) => { menu.open = false; });
      }
    });

    header?.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        const openMenu = navMenus.find((menu) => menu.open);
        if (openMenu) {
          openMenu.open = false;
          openMenu.querySelector("summary")?.focus();
        }
      }
    });
  </script>

  <style>
    .home-mobile-nav > nav {
      scrollbar-width: none;
    }

    .home-mobile-nav > nav::-webkit-scrollbar {
      display: none;
    }

    .home-nav-menu[open] > summary .home-nav-chevron,
    .home-mobile-nav-group[open] > summary .home-nav-chevron {
      transform: rotate(180deg);
    }

    @media (prefers-reduced-motion: reduce) {
      .home-nav-chevron {
        transition: none;
      }
    }
  </style>

  <main>
    <section class="mx-auto grid max-w-7xl gap-14 px-5 pb-24 pt-12 sm:px-8 sm:pt-20 lg:grid-cols-[1.03fr_.97fr] lg:items-center lg:px-12 lg:pb-32 lg:pt-24">
      <div class="max-w-2xl">
        <p class="mb-7 inline-flex items-center gap-2 rounded-full border border-[#d8dfcf] bg-white/60 px-3.5 py-2 text-xs font-medium tracking-wide text-moss">
          <span class="size-2 rounded-full bg-[#78a467]"></span>
          OPEN SOURCE · BUILT FOR YOUR REPOSITORY
        </p>
        <h1 class="max-w-[12ch] text-[clamp(2.6rem,8vw,6.6rem)] font-semibold leading-[.91] tracking-[-.075em] text-ink">
          Development,<br /><span class="text-moss">orchestrated.</span>
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-8 text-[#566356] sm:text-xl sm:leading-9">
          Give the work around your code a shared home. Define project tasks once, then run them from the terminal, Git hooks, your editor, or CI.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="https://docs.everyinit.dev/book/installation" class="group inline-flex items-center gap-3 rounded-full bg-ink px-6 py-4 text-sm font-semibold text-paper shadow-[0_12px_28px_-16px_#18211b] transition hover:-translate-y-0.5 hover:bg-moss active:scale-[.98]">
            Start with Evin <span class="text-lime motion-safe:transition-transform motion-safe:duration-200 group-hover:translate-x-1" aria-hidden="true">↗</span>
          </a>
          <a href="https://github.com/dukasn/everyinit" class="group inline-flex items-center gap-2 rounded-full border border-[#cfd5ca] px-6 py-4 text-sm font-semibold text-ink transition hover:border-moss hover:bg-white/70 active:scale-[.98]">
            Explore the project <span class="motion-safe:transition-transform motion-safe:duration-200 group-hover:translate-x-1" aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="mt-5 text-xs leading-5 text-moss">Early development · Downloads are coming soon · Install from source today</p>
      </div>

      <div class="relative mx-auto w-full max-w-[590px] lg:ml-auto">
        <div class="home-hero-backdrop absolute -inset-2 rotate-0 rounded-[2rem] bg-[#e2e7d8] sm:-inset-4 sm:-rotate-2"></div>
        <div class="relative overflow-hidden rounded-[1.5rem] border border-[#334337] bg-[#17211a] shadow-[0_30px_90px_-35px_rgba(22,34,24,.55)] transition-[border-color,box-shadow] duration-300 hover:border-[#65765d] hover:shadow-[0_36px_100px_-35px_rgba(22,34,24,.68)] motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-out motion-safe:hover:-translate-y-1">
          <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
            <div class="flex gap-1.5"><span class="size-2.5 rounded-full bg-[#839278]"></span><span class="size-2.5 rounded-full bg-[#62735c]"></span><span class="size-2.5 rounded-full bg-[#4b5c4b]"></span></div>
            <span class="font-mono text-[11px] text-[#9eac9a]">storefront · evin</span>
            <span class="rounded-full bg-[#25372a] px-2.5 py-1 font-mono text-[10px] text-[#c9e3b9]">ready</span>
          </div>
          <div class="px-5 py-6 sm:px-7 sm:py-8">
            <p class="font-mono text-xs text-[#a0ae9b]">.evin/workspace.flow</p>
            <pre class="home-hero-code mt-5 overflow-x-auto font-mono text-[12px] leading-[1.9] text-[#e5ebdf] sm:text-[13px]"><code set:html={renderHighlightedCode(heroCode, "flow")}></code></pre>
          </div>
          <div class="border-t border-white/10 bg-[#1d2a20] px-5 py-4 sm:px-7">
            <div class="flex items-center justify-between font-mono text-[11px]">
              <span class="text-[#a7b3a2]">$ evin run test</span><span class="text-[#c3e4a0]">✓ passed</span>
            </div>
            <div class="mt-3 flex gap-2"><span class="h-1.5 flex-[2] rounded-full bg-[#91b775]"></span><span class="h-1.5 flex-1 rounded-full bg-[#6c8862]"></span><span class="h-1.5 flex-[3] rounded-full bg-[#4b644b]"></span></div>
            <p class="mt-3 font-mono text-[10px] text-[#92a18e]">lint  0.42s <span class="px-2">·</span> tests  2.18s <span class="px-2">·</span> workspace clean</p>
          </div>
        </div>
        <div class="absolute -bottom-7 -left-5 hidden rounded-2xl border border-[#d5ddce] bg-surface px-4 py-3 shadow-lg sm:flex sm:items-center sm:gap-3">
          <span class="grid size-9 place-items-center rounded-full bg-lime text-lg">↳</span>
          <span><span class="block text-xs font-semibold">One task graph</span><span class="block text-[11px] text-moss">Terminal · hooks · CI</span></span>
        </div>
      </div>
    </section>

    <section id="integrations" class="border-y border-[#dfe3d9] bg-[#eeeee6]">
      <div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-7 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:px-12">
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-moss">One project workflow, wherever work happens</p>
        <div class="flex flex-wrap gap-x-7 gap-y-3 text-sm text-[#536052]">
          {integrations.map((integration) => <span class="inline-flex items-center gap-2"><span class="size-1.5 rounded-full bg-[#8eaa7b]"></span>{integration}</span>)}
        </div>
      </div>
    </section>

    <section id="workflow" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
        <div class="max-w-md">
          <p class="text-xs font-semibold uppercase tracking-[.16em] text-moss">Less glue. More flow.</p>
          <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-[-.055em] sm:text-5xl">Your project has a rhythm. Make it repeatable.</h2>
          <p class="mt-6 text-base leading-7 text-[#637063]">Evin brings commands, dependencies, scripts, and delivery steps into a workspace your team can understand and keep improving.</p>
          <a href="https://docs.everyinit.dev/book" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-ink underline decoration-[#a6b69a] underline-offset-4">See how it works <span aria-hidden="true">↗</span></a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {principles.map((item) => <article class="rounded-2xl border border-line bg-surface p-6 transition-[border-color,box-shadow] duration-300 hover:border-[#aab8a0] hover:shadow-[0_16px_36px_-28px_rgba(23,33,26,.5)] sm:p-7 motion-safe:transition-transform motion-safe:duration-300 motion-safe:hover:-translate-y-1">
            <p class="font-mono text-xs text-moss">{item.number} / WORKFLOW</p>
            <h3 class="mt-8 text-xl font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-[#647064]">{item.text}</p>
          </article>)}
          <article class="rounded-2xl bg-[#d9e5cf] p-6 sm:p-7">
            <p class="font-mono text-xs text-[#435741]">MADE FOR THE WHOLE REPOSITORY</p>
            <div class="mt-8 flex items-end justify-between gap-4">
              <p class="max-w-[15rem] text-xl font-semibold leading-snug tracking-tight">One version of the workflow, from laptop to release.</p>
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-ink text-xl text-lime">↗</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="projects" class="border-y border-[#dfe3d9] bg-[#eeeee6]">
      <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28">
        <div class="mb-10 grid gap-6 sm:mb-12 lg:grid-cols-[1fr_auto] lg:items-end">
          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-[.16em] text-moss">The Everyinit ecosystem</p>
            <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-[-.055em] sm:text-5xl">One core, connected extensions.</h2>
          </div>
          <p class="max-w-md text-sm leading-6 text-[#637063]">The workflow stays at the center. Language, editor, and web tooling build on the same workspace and move forward together.</p>
        </div>

        <div class="grid overflow-hidden rounded-[1.75rem] border border-[#cbd4c4] bg-surface lg:grid-cols-[.78fr_1.22fr]">
          <article class="relative flex flex-col justify-between gap-10 bg-ink p-7 text-paper sm:p-10">
            <div>
              <p class="font-mono text-xs uppercase tracking-[.14em] text-[#bac8b0]">01 <span class="px-1 text-[#71806e]">/</span> Core</p>
              <h3 class="mt-8 text-4xl font-semibold tracking-[-.05em] sm:text-5xl">Evin</h3>
              <p class="mt-4 max-w-sm text-sm leading-6 text-[#c0c9bc]">The Rust command line engine reads the workspace and coordinates each task, action, and integration.</p>
            </div>
            <a href="https://docs.everyinit.dev/book/first-workflow" class="group inline-flex w-fit items-center gap-2 text-sm font-semibold text-[#d8eba9] underline decoration-[#829871] underline-offset-4 hover:text-white">
              Build your first workflow <span class="motion-safe:transition-transform motion-safe:duration-200 group-hover:translate-x-1" aria-hidden="true">↗</span>
            </a>
            <span aria-hidden="true" class="pointer-events-none absolute -right-5 top-1/2 hidden size-10 -translate-y-1/2 items-center justify-center rounded-full border-[6px] border-[#eeeee6] bg-[#91ad78] text-lg text-ink lg:flex">›</span>
          </article>

          <div class="divide-y divide-line px-6 sm:px-10">
            {projects.map((project) => <article class="grid gap-3 py-6 sm:grid-cols-[3.5rem_1fr_auto] sm:items-center sm:gap-5 sm:py-7">
              <span class="font-mono text-xs text-[#84917f]">{project.number}</span>
              <div>
