#!evin/v1
namespace:
  name: release
  description: "Release engineering and distribution pipelines"

tasks:
  bump:
    stage: Publish
    description: "Calculate and apply the next release version"
    steps:
      - uses: evin/version-bumper@v1
        with:
          initial_version: "0.1.0"
          require_change: false
          files:
            - "Cargo.toml"
            - path: ".evin/workspace.flow"
              match: 'version:\s*"${previous_version}"'
              write: 'version: "${version}"'
            - path: "editors/vscode/package.json"
              match: '"version":\s*"${previous_version}"'
              write: '"version": "${version}"'
            - path: "packages/everyinit/package.json"
              match: '"version":\s*"${previous_version}"'
              write: '"version": "${version}"'
            - path: "apps/everyinit/package.json"
              match: '"version":\s*"${previous_version}"'
              write: '"version": "${version}"'
            - path: "docs/.evin/module.flow"
              match: 'id:\s*v${previous_version}'
              write: 'id: v${version}'
            - path: "docs/.evin/module.flow"
              match: 'latest_version:\s*v${previous_version}'
              write: 'latest_version: v${version}'
          git:
            commit: true
            tag: true
            defer: true
      - run: cargo update --workspace
      - run: npm install --package-lock-only
      - run: cargo check --workspace --locked

  changelog:
    stage: Publish
    description: "Generate the canonical changelog section"
    needs:
      - release:bump
    steps:
      - run: mkdir -p target
      - run: rm -f target/release-notes.md
      - run: touch target/release-notes.md
      - uses: evin/changelog@v1
        with:
          path: CHANGELOG.md
          version: ${release:bump.version}
          notes_path: target/release-notes.md
      - run: cargo run --locked -p esh -- scripts/release/notes/add-channel-status.esh CHANGELOG.md
      - run: cargo run --locked -p esh -- scripts/release/notes/add-channel-status.esh target/release-notes.md

  propose:
    stage: Publish
    description: "Commit and reconcile the release proposal without creating a tag"
    env: [GITHUB_TOKEN, RELEASE_BRANCH]
    needs:
      - release:changelog
      - release:bump
    steps:
      - run: cargo evin-dev run docs:evin-catalog
      - run: cargo evin-dev run docs:esh-catalog
      - run: git add Cargo.toml Cargo.lock .evin/workspace.flow .evin/release-lock.json CHANGELOG.md package-lock.json
      - run: git add crates/evin/assets/config-catalog.json crates/esh/assets/builtins-catalog.json
      - run: git add editors/vscode/package.json
      - run: git add packages/everyinit/package.json apps/everyinit/package.json
      - run: git add docs/.evin/module.flow
      - uses: evin/git-release@v1
        with:
          stage: existing
          enabled: ${release:bump.changed}
          message: |-
            chore(release): ${release:bump.version}
          push:
            branch: "${env.RELEASE_BRANCH}"
            force: true
      - uses: evin/review-request@v1
        with:
          branch: "${env.RELEASE_BRANCH}"
          base: main
          wanted: ${release:bump.changed}
          title: "chore(release): ${release:bump.tag}"
          body_path: target/release-notes.md
          commands:
            find: gh pr list --head "$EVIN_REVIEW_BRANCH" --base "$EVIN_REVIEW_BASE" --state open --json number --jq '.[0].number // empty'
            create: gh pr create --head "$EVIN_REVIEW_BRANCH" --base "$EVIN_REVIEW_BASE" --title "$EVIN_REVIEW_TITLE" --body-file "$EVIN_REVIEW_BODY_FILE"
            update: gh pr edit "$EVIN_REVIEW_ID" --title "$EVIN_REVIEW_TITLE" --body-file "$EVIN_REVIEW_BODY_FILE"
            close: gh pr close "$EVIN_REVIEW_ID" --delete-branch --comment "Nothing left to release."
