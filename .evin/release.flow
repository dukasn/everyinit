#!evin/v1
namespace:
  name: release
  description: "Release engineering and distribution pipelines"

tasks:
  doctor:
    stage: Publish
    description: "Report Linux musl release prerequisite availability"
    steps:
      - run: cargo run --locked -p esh -- scripts/release/doctor.esh

  rehearsal-start:
    stage: Publish
    description: "Record repository status before generating the release rehearsal"
    steps:
      - run: node scripts/release/verify-rehearsal-clean.mjs --snapshot

  changelog-rehearsal:
    stage: Publish
    description: "Generate and verify the candidate changelog in ignored output"
    env: [RELEASE_VERSION]
    needs: [release:rehearsal-start]
    steps:
      - uses: evin/changelog@v1
        with:
          path: target/release-rehearsal/CHANGELOG.md
          version: "${env.RELEASE_VERSION}"
      - run: node scripts/release/verify-changelog.mjs target/release-rehearsal/CHANGELOG.md "$RELEASE_VERSION"

  distribution-rehearsal:
    stage: Publish
    description: "Build and verify all Evin, ESH, and editor extension distribution formats without publishing"
    env: [RELEASE_TARGET, RELEASE_VERSION]
    needs:
      - release:changelog-rehearsal
      - evin:package:distribution-verify
      - esh:package:distribution-verify
      - vscode:package:distribution-verify
    steps:
      - run: node scripts/release/verify-rehearsal-clean.mjs

  bump:
    stage: Publish
    description: "Calculate and apply the next release version"
    steps:
      - uses: evin/version-bumper@v1
        with:
          initial_version: "0.1.0"
          require_change: false
          files:
            - "Cargo.toml"
            - path: ".evin/workspace.flow"
              match: 'version:\s*"${previous_version}"'
              write: 'version: "${version}"'
            - path: "editors/vscode/package.json"
              match: '"version":\s*"${previous_version}"'
              write: '"version": "${version}"'
          git:
            commit: true
            tag: true
            defer: true
      - run: cargo update --workspace
      - run: cargo check --workspace --locked

  changelog:
    stage: Publish
    description: "Generate the canonical changelog section"
    needs:
      - release:bump
    steps:
      - run: mkdir -p target
      - run: rm -f target/release-notes.md
      - run: touch target/release-notes.md
      - uses: evin/changelog@v1
        with:
          path: CHANGELOG.md
          version: ${release:bump.version}
          notes_path: target/release-notes.md

  propose:
    stage: Publish
    description: "Commit and reconcile the release proposal without creating a tag"
    env: [GITHUB_TOKEN, RELEASE_BRANCH]
    needs:
      - release:changelog
      - release:bump
    steps:
      - run: cargo evin-dev run docs:evin-catalog
      - run: cargo evin-dev run docs:catalog
      - run: git add Cargo.toml Cargo.lock .evin/workspace.flow .evin/release-lock.json CHANGELOG.md
      - run: git add crates/evin/assets/config-catalog.json crates/esh/assets/builtins-catalog.json
      - run: git add editors/vscode/package.json
      - uses: evin/git-release@v1
        with:
          stage: existing
          enabled: ${release:bump.changed}
          message: |-
            chore(release): ${release:bump.version}
          push:
            branch: "${env.RELEASE_BRANCH}"
            force: true
      - uses: evin/review-request@v1
        with:
          branch: "${env.RELEASE_BRANCH}"
          base: main
          wanted: ${release:bump.changed}
          title: "chore(release): ${release:bump.tag}"
          body_path: target/release-notes.md
          commands:
            find: gh pr list --head "$EVIN_REVIEW_BRANCH" --base "$EVIN_REVIEW_BASE" --state open --json number --jq '.[0].number // empty'
            create: gh pr create --head "$EVIN_REVIEW_BRANCH" --base "$EVIN_REVIEW_BASE" --title "$EVIN_REVIEW_TITLE" --body-file "$EVIN_REVIEW_BODY_FILE"
            update: gh pr edit "$EVIN_REVIEW_ID" --title "$EVIN_REVIEW_TITLE" --body-file "$EVIN_REVIEW_BODY_FILE"
            close: gh pr close "$EVIN_REVIEW_ID" --delete-branch --comment "Nothing left to release."

  release-notes:
    stage: Publish
    description: "Export the merged changelog section for the release"
    env: [RELEASE_TAG]
    steps:
      - uses: evin/changelog@v1
        with:
          section: "${env.RELEASE_TAG}"
          notes_path: target/release-notes.md

  release-stage:
    stage: Publish
    description: "Build and stage the two release binaries"
    env: [RELEASE_TARGET, RELEASE_VERSION]
    steps:
      - run: rm -rf target/release-archives target/release-staging
      - run: mkdir -p target/release-archives target/release-staging
      - run: cargo build --release --locked --target "$RELEASE_TARGET" -p evin -p esh
      - run: cargo run --locked -p esh -- scripts/release/verify-binary.esh evin "$RELEASE_TARGET" "$RELEASE_VERSION"
      - run: cargo run --locked -p esh -- scripts/release/verify-binary.esh esh "$RELEASE_TARGET" "$RELEASE_VERSION"
      - run: cargo run --locked -p esh -- scripts/release/stage.esh evin "$RELEASE_TARGET" "$RELEASE_VERSION" target/release-staging
      - run: cargo run --locked -p esh -- scripts/release/stage.esh esh "$RELEASE_TARGET" "$RELEASE_VERSION" target/release-staging

  release-archives:
    stage: Publish
    description: "Archive Linux tar.gz release binaries"
    cwd: target/release-staging
    env: [RELEASE_TARGET, RELEASE_VERSION]
    needs: [release:release-stage]
    steps:
      - uses: evin/archive@v1
        with:
          path: "../release-archives/evin-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}.tar.gz"
          include: ["evin-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/**/*"]
          layout: relative
      - uses: evin/archive@v1
        with:
          path: "../release-archives/esh-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}.tar.gz"
          include: ["esh-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/**/*"]
          layout: relative

  release-native-packages:
    stage: Publish
    description: "Build Evin and ESH Debian and Arch packages"
    env: [RELEASE_TARGET, RELEASE_VERSION]
    needs:
      - release:release-stage
      - release:package-state
    steps:
      - uses: evin/archive@v1
        with:
          format: deb
          output_dir: target/release-archives
          architecture: x86_64
          release: "${release:package-state.release}"
          package:
            name: evin
            summary: Evin workflow engine
            maintainer: Everyinit contributors
            license: GPL-3.0-only
            homepage: https://everyinit.dev
            payload:
              - source: "target/release-staging/evin-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin/evin"
                strip_prefix: "target/release-staging/evin-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin"
                destination: /usr/bin
                mode: 493
              - source: LICENSE
                strip_prefix: .
                destination: /usr/share/licenses/evin
              - source: THIRD_PARTY_NOTICES.md
                strip_prefix: .
                destination: /usr/share/doc/evin
              - source: LICENSES/**/*
                strip_prefix: LICENSES
                destination: /usr/share/licenses/evin/LICENSES
            targets:
              deb: {}
      - uses: evin/archive@v1
        with:
          format: arch
          output_dir: target/release-archives
          architecture: x86_64
          release: "${release:package-state.release}"
          package:
            name: evin
            summary: Evin workflow engine
            maintainer: Everyinit contributors
            license: GPL-3.0-only
            homepage: https://everyinit.dev
            payload:
              - source: "target/release-staging/evin-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin/evin"
                strip_prefix: "target/release-staging/evin-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin"
                destination: /usr/bin
                mode: 493
              - source: LICENSE
                strip_prefix: .
                destination: /usr/share/licenses/evin
              - source: THIRD_PARTY_NOTICES.md
                strip_prefix: .
                destination: /usr/share/doc/evin
              - source: LICENSES/**/*
                strip_prefix: LICENSES
                destination: /usr/share/licenses/evin/LICENSES
            targets:
              arch: {}
      - uses: evin/archive@v1
        with:
          format: deb
          output_dir: target/release-archives
          architecture: x86_64
          release: "${release:package-state.release}"
          package:
            name: esh
            summary: ESH portable shell runtime
            maintainer: Everyinit contributors
            license: GPL-3.0-only
            homepage: https://everyinit.dev
            payload:
              - source: "target/release-staging/esh-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin/esh"
                strip_prefix: "target/release-staging/esh-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin"
                destination: /usr/bin
                mode: 493
              - source: LICENSE
                strip_prefix: .
                destination: /usr/share/licenses/esh
              - source: THIRD_PARTY_NOTICES.md
                strip_prefix: .
                destination: /usr/share/doc/esh
              - source: LICENSES/**/*
                strip_prefix: LICENSES
                destination: /usr/share/licenses/esh/LICENSES
            targets:
              deb: {}
      - uses: evin/archive@v1
        with:
          format: arch
          output_dir: target/release-archives
          architecture: x86_64
          release: "${release:package-state.release}"
          package:
            name: esh
            summary: ESH portable shell runtime
            maintainer: Everyinit contributors
            license: GPL-3.0-only
            homepage: https://everyinit.dev
            payload:
              - source: "target/release-staging/esh-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin/esh"
                strip_prefix: "target/release-staging/esh-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin"
                destination: /usr/bin
                mode: 493
              - source: LICENSE
                strip_prefix: .
                destination: /usr/share/licenses/esh
              - source: THIRD_PARTY_NOTICES.md
                strip_prefix: .
                destination: /usr/share/doc/esh
              - source: LICENSES/**/*
                strip_prefix: LICENSES
                destination: /usr/share/licenses/esh/LICENSES
            targets:
              arch: {}

  release-vscode:
    stage: Publish
    description: "Package Everyinit VS Code extension for release"
    env: [RELEASE_VERSION]
    # Staging clears the shared archive directory before any package is written.
    needs: [release:release-stage]
    steps:
      - run: npm --prefix editors/vscode run package
      - run: mkdir -p target/release-archives
      - run: cp editors/vscode/dist/github/everyinit-${RELEASE_VERSION}.vsix target/release-archives/

  release-sign:
    stage: Publish
    description: "Cryptographically sign all release packages and manifests"
    env: [RELEASE_VERSION, EVERYINIT_RELEASE_SIGNING_KEY, RELEASE_SIGNING_KEY, RELEASE_SIGNING_KEY_FILE]
    needs:
      - release:release-archives
      - release:release-native-packages
      - release:release-vscode
    steps:
      - run: node scripts/release/sign-packages.mjs target/release-archives "$RELEASE_VERSION"

  release-archives-verify:
    stage: Publish
    description: "Inspect all release archives, native packages, VS Code extension, and cryptographic signatures"
    env: [RELEASE_TARGET, RELEASE_VERSION]
    needs: [release:release-sign]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/verify-archive.esh evin "$RELEASE_TARGET" "$RELEASE_VERSION" target/release-archives
      - run: cargo run --locked -p esh -- scripts/release/verify-archive.esh esh "$RELEASE_TARGET" "$RELEASE_VERSION" target/release-archives
      - run: node scripts/release/verify-release-packages.mjs target/release-archives "$RELEASE_VERSION" "$RELEASE_TARGET"

  tag-verify:
    stage: Publish
    description: "Verify the tag and shared workspace version"
    env: [RELEASE_TAG, RELEASE_VERSION]
    needs:
      - test
    steps:
      - run: cargo run --locked -p esh -- scripts/release/verify-tag.esh "$RELEASE_TAG" "$RELEASE_VERSION"

  candidate-validate:
    stage: Publish
    description: "Validate a tagged release candidate before it can merge"
    env: [RELEASE_BASE_SHA, RELEASE_COMMIT, RELEASE_TAG, RELEASE_VERSION]
    steps:
      - run: node scripts/release/validate-candidate.mjs "$RELEASE_TAG" "$RELEASE_VERSION" "$RELEASE_COMMIT" "$RELEASE_BASE_SHA"

  package-state:
    stage: Publish
    description: "Resolve package revisions without changing the checkout"
    env: [RELEASE_VERSION]
    steps:
      - uses: evin/version-bumper@v1
        with:
          initial_version: "0.1.0"
          read_only: true
          fixed_version: "${env.RELEASE_VERSION}"

  package:
    stage: Publish
    description: "Build all GitHub release formats for Evin, ESH, and editor extensions"
    needs:
      - release:tag-verify
      - evin:package:github
      - esh:package:github
      - vscode:package:github

  package-cloudflare:
    stage: Publish
    description: "Build only the tar.gz artifacts used by the Cloudflare mirror"
    needs:
      - release:tag-verify
      - evin:package:cloudflare
      - esh:package:cloudflare

  package-cloudflare-verify:
    stage: Publish
    description: "Verify the tar.gz artifacts used by the Cloudflare mirror"
    needs:
      - release:package-cloudflare
      - evin:package:cloudflare-verify
      - esh:package:cloudflare-verify

  package-verify:
    stage: Publish
    description: "Verify all release archives and editor packages"
    needs:
      - release:package
      - evin:package:github-verify
      - esh:package:github-verify
      - vscode:package:github-verify

  publish-prebuilt:
    stage: Publish
    description: "Publish the prebuilt release and move the canary mirror pointers last"
    needs: [infra:mirror:publish-pointers]

  github-publish:
    stage: Publish
    description: "Reconcile and publish the release through Evin CI actions"
    env: [GITHUB_REPOSITORY, GITHUB_TOKEN, GITHUB_API_URL, GITHUB_STEP_SUMMARY, RELEASE_TAG, RELEASE_VERSION]
    needs:
      - release:package-verify
      - infra:mirror:metadata
    steps:
      - run: node scripts/release/github-ci.mjs snapshot "$RELEASE_TAG"
      - uses: evin/ci@v1
        with:
          tag: "${env.RELEASE_TAG}"
          title: "${env.RELEASE_TAG}"
          state: .evin/actions/ci/remote-state.v1.json
          plan_out: .evin/actions/ci/evin-plan.v1.json
          notes_dir: .evin/actions/ci/notes/evin
          artifacts_dir: crates/evin/dist/github
          changelog: CHANGELOG.md
      - run: node scripts/release/github-ci.mjs apply .evin/actions/ci/evin-plan.v1.json
      - run: node scripts/release/github-ci.mjs snapshot "$RELEASE_TAG"
      - uses: evin/ci@v1
        with:
          tag: "${env.RELEASE_TAG}"
          title: "${env.RELEASE_TAG}"
          state: .evin/actions/ci/remote-state.v1.json
          plan_out: .evin/actions/ci/esh-plan.v1.json
          notes_dir: .evin/actions/ci/notes/esh
          artifacts_dir: crates/esh/dist/github
          changelog: CHANGELOG.md
      - run: node scripts/release/github-ci.mjs apply .evin/actions/ci/esh-plan.v1.json
      - run: node scripts/release/github-ci.mjs snapshot "$RELEASE_TAG"
      - uses: evin/ci@v1
        with:
          tag: "${env.RELEASE_TAG}"
          title: "${env.RELEASE_TAG}"
          state: .evin/actions/ci/remote-state.v1.json
          plan_out: .evin/actions/ci/vscode-plan.v1.json
          notes_dir: .evin/actions/ci/notes/vscode
          artifacts_dir: editors/vscode/dist/github
          changelog: CHANGELOG.md
      - run: node scripts/release/github-ci.mjs apply .evin/actions/ci/vscode-plan.v1.json
      - run: node scripts/release/github-ci.mjs summary "$RELEASE_TAG"

  github-publish-prebuilt:
    stage: Publish
    description: "Publish verified downloaded artifacts without rebuilding them"
    env: [GITHUB_REPOSITORY, GITHUB_TOKEN, GITHUB_API_URL, GITHUB_STEP_SUMMARY, RELEASE_TAG]
    needs:
      - infra:mirror:metadata-prebuilt
      - infra:mirror:publish-objects
    steps:
      - run: node scripts/release/github-ci.mjs snapshot "$RELEASE_TAG"
      - uses: evin/ci@v1
        with:
          tag: "${env.RELEASE_TAG}"
          title: "${env.RELEASE_TAG}"
          state: .evin/actions/ci/remote-state.v1.json
          plan_out: .evin/actions/ci/evin-plan.v1.json
          notes_dir: .evin/actions/ci/notes/evin
          artifacts_dir: crates/evin/dist/github
          changelog: CHANGELOG.md
      - run: node scripts/release/github-ci.mjs apply .evin/actions/ci/evin-plan.v1.json
      - run: node scripts/release/github-ci.mjs snapshot "$RELEASE_TAG"
      - uses: evin/ci@v1
        with:
          tag: "${env.RELEASE_TAG}"
          title: "${env.RELEASE_TAG}"
          state: .evin/actions/ci/remote-state.v1.json
          plan_out: .evin/actions/ci/esh-plan.v1.json
          notes_dir: .evin/actions/ci/notes/esh
          artifacts_dir: crates/esh/dist/github
          changelog: CHANGELOG.md
      - run: node scripts/release/github-ci.mjs apply .evin/actions/ci/esh-plan.v1.json
      - run: node scripts/release/github-ci.mjs snapshot "$RELEASE_TAG"
      - uses: evin/ci@v1
        with:
          tag: "${env.RELEASE_TAG}"
          title: "${env.RELEASE_TAG}"
          state: .evin/actions/ci/remote-state.v1.json
          plan_out: .evin/actions/ci/vscode-plan.v1.json
          notes_dir: .evin/actions/ci/notes/vscode
          artifacts_dir: editors/vscode/dist/github
          changelog: CHANGELOG.md
      - run: node scripts/release/github-ci.mjs apply .evin/actions/ci/vscode-plan.v1.json
      - run: node scripts/release/github-ci.mjs summary "$RELEASE_TAG"
