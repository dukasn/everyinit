# Git plugin locale messages

identity-not-configured = Git identity is not configured (user.name / user.email missing)
tag-already-exists = Tag '{ $tag }' already exists. This usually indicates that no new releasable commits were found since the last release, or the tag was manually created.
invalid-tag-name = Invalid tag name '{ $tag }'
no-staged-changes = No staged changes to commit
tag-recovery-failed = Commit '{ $commit_id }' succeeded, but tagging '{ $tag }' failed: { $error }. The tag may be retried after correcting the problem.
calculated-tag-already-exists = The version bumper calculated a new version '{ $version }', but the tag '{ $tag }' already exists in the repository. This usually happens if the tag is orphaned or points to a commit outside the current branch history.
message-must-not-be-empty = message must not be empty
tag-must-not-be-empty-when-provided = tag must not be empty when provided
git-release-enabled-must-be-boolean = enabled must be true or false, got '{ $value }'
git-release-push-remote-must-not-be-empty = push.remote must not be empty
git-release-push-branch-must-not-be-empty = push.branch must not be empty when provided
git-release-prune-stale-tags-requires-tag = push.prune_stale_tags requires tag
git-release-prune-stale-tags-requires-base = push.prune_stale_tags requires push.base
git-release-push-base-requires-prune-stale-tags = push.base is only valid with push.prune_stale_tags
git-release-template-syntax-invalid = Invalid template syntax: { $error }
git-release-template-resolution-failed = Could not resolve the { $field } template: { $error }
git-release-enabled-field = enabled
git-release-commit-message-field = commit message
git-release-tag-field = tag
git-release-current-branch-failed = Could not determine the current branch for publishing: { $error }
git-release-push-failed = Push to '{ $remote }' failed; the local commit is intact and the push can be retried: { $error }
git-release-push-with-tag-failed = Push to '{ $remote }' failed; the local commit and tag '{ $tag }' are intact and the push can be retried: { $error }
git-release-prune-tag-format-invalid = Tag format is not usable for pruning: { $error }
git-release-prune-tags-list-failed = Could not list tags on remote '{ $remote }' while pruning: { $error }
git-release-prune-tag-check-failed = Could not check whether stale tag '{ $tag }' is included in the base branch: { $error }
git-release-prune-tag-delete-failed = Could not delete stale tag '{ $tag }' from remote '{ $remote }': { $error }

identity-not-configured-title = Git Identity Error
tag-already-exists-title = Tag Exists
invalid-tag-name-title = Invalid Tag
no-staged-changes-title = Nothing to Commit
tag-recovery-failed-title = Tag Recovery Failed
calculated-tag-already-exists-title = Tag Conflict
git-release-current-branch-failed-title = Branch Detection Failed
git-release-push-failed-title = Push Failed
git-release-push-with-tag-failed-title = Push Failed
git-release-prune-tag-format-invalid-title = Tag Pruning Configuration Invalid
git-release-prune-tags-list-failed-title = Tag Pruning Failed
git-release-prune-tag-check-failed-title = Tag Pruning Failed
git-release-prune-tag-delete-failed-title = Tag Pruning Failed
git-release-template-resolution-failed-title = Git Release Template Failed
git-release-invalid-config-title = Invalid Git Release Configuration
