# Archive plugin locale messages

invalid-config = Invalid Archive configuration: { $error }
no-files-matched = No files matched the provided include globs.
unsupported-format = Format '{ $format }' is not supported.
safe-path-resolution-failed-path = Safe path resolution failed for archive path: { $error }
create-output-dir-failed = Failed to create output directory: { $error }
invalid-glob = Invalid glob pattern: { $error }
invalid-file = Invalid file: { $path }
safe-path-resolution-failed-source = Safe path resolution failed for source: { $error }
glob-error = Glob error: { $error }
create-output-file-failed = Failed to create output file: { $error }
archive-failed = Failed to archive { $path }: { $error }
finalize-archive-failed = Failed to finalize tar.gz archive: { $error }
path-collision = Archive collision: '{ $destination }' is targeted by both '{ $source1 }' and '{ $source2 }'
relative-path-escape = File '{ $path }' is outside the task directory, which is incompatible with 'layout: relative'. Use 'layout: flat' or restrict includes to the task directory.
archive-path-must-not-be-empty = path must not be empty
include-must-contain-at-least-one-pattern = include must contain at least one pattern
include-patterns-must-not-be-empty = include patterns must not be empty
exclude-patterns-must-not-be-empty = exclude patterns must not be empty
prefix-must-not-be-empty-when-provided = prefix must not be empty when provided
compression-level-invalid = compression_level must be between 1 and 9
archive-distro-fields-only-on-package-formats = output_dir, architecture, release, and package are only valid for distro package formats
archive-distro-fields-required = output_dir, architecture, release, and package are required for distro package formats
archive-tar-gz-fields-only-on-tar-gz = path, include, exclude, prefix, layout, and compression_level are only valid for tar.gz
archive-package-script-read-failed = failed to read package script: { $error }
archive-package-name-invalid = package name contains unsupported characters
archive-package-metadata-invalid = package { $field } must be non-empty and contain no line breaks
archive-package-relation-invalid = package { $field } entries must be non-empty single-line strings
archive-package-relation-duplicate = package { $field } contains '{ $value }' more than once
archive-package-script-path-empty = package script path must not be empty
package-path-invalid = invalid package path '{ $path }'
package-path-collision = package path collision at '{ $path }'
package-input-read-failed = could not read package input '{ $path }': { $error }
package-source-date-epoch-invalid = invalid SOURCE_DATE_EPOCH value '{ $value }'
package-archive-write-failed = could not write package archive: { $error }
package-path-invalid-title = Invalid Package Path
package-path-collision-title = Package Path Collision
package-input-read-failed-title = Package Input Read Failed
package-source-date-epoch-invalid-title = Invalid Build Timestamp
package-archive-write-failed-title = Package Archive Write Failed
archive-release-reference-missing-need = release references '{ $task }', but that task is not declared in needs
archive-package-target-missing = package has no { $format } target
archive-release-output-invalid = invalid release output: { $error }
archive-release-schema-unsupported = unsupported release schema { $schema }
archive-release-revision-missing = release has no resolved '{ $target }' revision for package '{ $package }'
archive-release-version-revision-invalid = release contains an invalid version or revision
archive-release-reference-format-invalid = release must be exactly '${task.release}'
archive-dry-run-inputs-unverified = Archive inputs could not be verified: { $includes }
archive-blocking-task-failed = Blocking task failed: { $error }
archive-field-invalid-for-format = '{ $field }' is not valid when format is '{ $format }'
archive-source-date-epoch-invalid = Invalid SOURCE_DATE_EPOCH: { $error }
archive-source-date-epoch-unavailable = SOURCE_DATE_EPOCH is absent and Git HEAD timestamp is unavailable: { $error }

invalid-config-title = Invalid Archive Configuration
no-files-matched-title = No Files Matched
unsupported-format-title = Unsupported Format
create-output-dir-failed-title = Archive Failed
create-output-file-failed-title = Archive Failed
archive-failed-title = Archive Failed
finalize-archive-failed-title = Archive Failed
path-collision-title = Path Collision
relative-path-escape-title = Path Escape
archive-path-must-not-be-empty-title = Invalid Archive Configuration
invalid-glob-title = Invalid Glob
compression-level-invalid-title = Invalid Configuration
