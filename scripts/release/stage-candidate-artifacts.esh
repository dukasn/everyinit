set -e

assert [ "$#" -eq 2 ] "usage: stage-candidate-artifacts.esh <artifact-root> <version>"
ARTIFACT_ROOT="$1"
VERSION="$2"
assert [ -d "$ARTIFACT_ROOT" ] "candidate artifact root is missing: $ARTIFACT_ROOT"
if ! echo "$VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'; then
  echo "release version is not supported: $VERSION" >&2
  exit 1
fi

for BINARY in evin esh; do
  FILENAME="${BINARY}-v${VERSION}-x86_64-unknown-linux-musl.tar.gz"
  PATTERN="$ARTIFACT_ROOT/**/$FILENAME"
  assert [ "$(glob "$PATTERN" | wc -l)" -eq 1 ] "expected exactly one $FILENAME in candidate artifacts"
  ARCHIVE=$(glob "$PATTERN")
  assert [ -f "$ARCHIVE" ] "candidate artifact is not a regular file: $ARCHIVE"
  OUTPUT="crates/$BINARY/dist/github/$FILENAME"
  mkdir -p "$(dirname "$OUTPUT")"
  cp "$ARCHIVE" "$OUTPUT"
done
