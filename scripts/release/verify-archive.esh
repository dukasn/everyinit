#!/usr/bin/env esh
set -e

assert [ "$#" -eq 4 ] "usage: verify-archive.esh <package> <target-triple> <version> <archive-root>"
PACKAGE="$1"
TARGET="$2"
VERSION="$3"
ARCHIVE_ROOT="$4"
if test "$PACKAGE" != "evin"; then
  if test "$PACKAGE" != "esh"; then
    echo "unsupported release package: $PACKAGE" >&2
    exit 1
  fi
fi
ARCHIVE="$ARCHIVE_ROOT/$PACKAGE-v$VERSION-$TARGET.tar.gz"
RELEASE_DIR="$PACKAGE-v$VERSION-$TARGET"
EXTRACT_DIR=$(mktemp -d)

assert [ -f "$ARCHIVE" ] "release archive is missing: $ARCHIVE"
tar -xzf "$ARCHIVE" -C "$EXTRACT_DIR"
assert [ "$(glob "$EXTRACT_DIR/*" | wc -l)" -eq 1 ] "archive must contain exactly one top-level entry"
ROOT="$EXTRACT_DIR/$RELEASE_DIR"
assert [ -d "$ROOT" ] "archive top-level directory must be $RELEASE_DIR"
assert [ "$(glob "$ROOT/*" | wc -l)" -eq 3 ] "archive must contain only its binary, LICENSE, and THIRD_PARTY_NOTICES"
assert [ -x "$ROOT/bin/$PACKAGE" ] "archived bin/$PACKAGE binary is not executable"
assert [ -f "$ROOT/LICENSE" ] "archive is missing LICENSE"
assert [ -d "$ROOT/THIRD_PARTY_NOTICES" ] "archive is missing THIRD_PARTY_NOTICES"
assert "$EXTRACT_DIR/$RELEASE_DIR/bin/$PACKAGE --version | grep -Fq '$VERSION'" -- "archived $PACKAGE version does not match $VERSION"

rm -rf "$EXTRACT_DIR"
