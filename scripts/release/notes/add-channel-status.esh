set -euo pipefail

assert [ "$#" -eq 1 ] "usage: add-channel-status.esh <notes-file>"
NOTES_FILE="$1"
assert [ -f "$NOTES_FILE" ] "release notes file is missing: $NOTES_FILE"

STATUS="Everyinit is canary-era software. CLI and ESH downloads use the canary mirror channel; npm and Marketplace packages use regular workspace versions. The extension is not published as a VS Code pre-release."
if grep -Fqx -- "$STATUS" "$NOTES_FILE"; then
  exit 0
fi

TEMP_FILE="$(mktemp "${NOTES_FILE}.tmp.XXXXXX")"
if [ "$(head -n 1 "$NOTES_FILE")" = "# Changelog" ]; then
  {
    head -n 2 "$NOTES_FILE"
    printf '\n%s\n\n' "$STATUS"
    tail -n +4 "$NOTES_FILE"
  } > "$TEMP_FILE"
else
  {
    printf '%s\n\n' "$STATUS"
    cat "$NOTES_FILE"
  } > "$TEMP_FILE"
fi
mv "$TEMP_FILE" "$NOTES_FILE"
