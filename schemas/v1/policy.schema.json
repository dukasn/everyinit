            },
            "docs": {
              "bump": "patch",
              "changelog_section": "Documentation"
            },
            "feat": {
              "bump": "minor",
              "changelog_section": "Features"
            },
            "fix": {
              "bump": "patch",
              "changelog_section": "Bug Fixes"
            },
            "perf": {
              "bump": "patch",
              "changelog_section": "Performance Improvements"
