{
  "name": "everyinit",
  "version": "0.3.4",
  "description": "JavaScript APIs, syntax highlighting, and Vite integration for Evin documentation data",
  "keywords": [
    "documentation",
    "everyinit",
    "evin",
    "search",
    "static-site",
    "syntax-highlighting",
    "textmate",
    "vite"
  ],
  "homepage": "https://everyinit.dev/docs/reference/everyinit-package",
  "bugs": {
    "url": "https://github.com/dukasn/everyinit/issues"
  },
  "license": "GPL-3.0-only",
  "author": "Eduardo Marques Santos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dukasn/everyinit.git",
    "directory": "packages/everyinit"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "highlight.js",
    "highlight.d.ts",
    "grammars/*.tmLanguage.json",
    "vite.js",
    "vite.d.ts",
    "virtual.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./highlight": {
      "types": "./highlight.d.ts",
      "import": "./highlight.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "shiki": "^4.6.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
