set -e

assert [ "$#" -eq 4 ] "usage: stage.esh <evin|esh> <target-triple> <version> <output-root>"

PACKAGE="$1"
TARGET="$2"
VERSION="$3"
OUTPUT_ROOT="$4"

if test "$PACKAGE" != "evin"; then
  assert [ "$PACKAGE" = "esh" ] "unsupported release binary: $PACKAGE"
fi
assert [ "$TARGET" = "x86_64-unknown-linux-musl" ] "unsupported release target: $TARGET"
assert [ -n "$VERSION" ] "release version must not be empty"
assert [ "$(basename "$VERSION")" = "$VERSION" ] "release version must be one path component"

BIN="target/$TARGET/release/$PACKAGE"
PACKAGE_DIR="$OUTPUT_ROOT/$PACKAGE-v$VERSION-$TARGET"
assert [ -f LICENSE ] "missing LICENSE"
assert [ -f THIRD_PARTY_NOTICES.md ] "missing THIRD_PARTY_NOTICES.md"
assert [ -d LICENSES ] "missing LICENSES directory"
assert [ -x "$BIN" ] "missing executable release binary: $BIN"

rm -rf "$PACKAGE_DIR"
mkdir -p "$PACKAGE_DIR/bin"
cp "$BIN" "$PACKAGE_DIR/bin/$PACKAGE"
cp LICENSE "$PACKAGE_DIR/LICENSE"
cp THIRD_PARTY_NOTICES.md "$PACKAGE_DIR/THIRD_PARTY_NOTICES.md"
cp -r LICENSES "$PACKAGE_DIR/LICENSES"

echo "Staged $PACKAGE release at $PACKAGE_DIR"
