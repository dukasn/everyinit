version-bumper-replacement-missing = version replacement did not match file: { $path }
version-bumper-dry-run-skipped-mutations = version bumping and git operations bypassed in dry-run
version-bumper-fixed-version-template-resolution-failed = Could not resolve the fixed_version template: { $error }
version-bumper-git-message-template-failed = Could not resolve the release commit message template: { $error }
version-bumper-template-syntax-invalid = Invalid template syntax: { $error }
