#!evin/v1
workspace:
  name: main
  version: "0.2.1"
  rules: ".evin/gitrules.flow"
  install_hint: "cargo install --path crates/evin"
  hook_runner:
    command: cargo
    args: [evin-dev]
  modules:
    - docs/
    - crates/evin/
    - crates/esh/
    - infra/
    - editors/vscode/
  include:
    - .evin/release.flow

stages:
  - Build
  - Check
  - Test
  - Docs
  - Publish

tasks:
  build:
    stage: Build
    description: "Build the complete Rust workspace"
    presets: [rust]
    steps:
      - run: cargo build --workspace --locked

  check:
    stage: Check
    description: "Check every workspace target"
    presets: [rust]
    steps:
      - run: cargo check --workspace --all-targets --locked

  fmt:
    stage: Check
    description: "Enforce workspace Rust formatting"
    presets: [rust]
    on:
      hooks: [pre-commit]
    steps:
      - run: cargo fmt --all -- --check

  lint:
    stage: Check
    description: "Run strict Clippy across every workspace target"
    presets: [rust]
    on:
      hooks: [pre-commit]
    steps:
      - run: cargo clippy --workspace --all-targets --locked -- -D warnings

  test:
    stage: Test
    description: "Run the locked workspace test suite"
    presets: [rust]
    on:
      hooks: [pre-commit]
    steps:
      - run: cargo test --workspace --locked

  e2e:
    stage: Test
    description: "Run Evin and ESH binary-level integration tests"
    needs:
      - evin:e2e
      - esh:e2e

  quality:
    stage: Check
    description: "Run Rust, browser documentation, Cloudflare infra, and editor extension quality checks"
    needs:
      - check
      - fmt
      - lint
      - docs:verify
      - infra:quality:verify
      - vscode:verify

  verify:
    stage: Test
    description: "Run the complete local validation gate"
    needs:
      - quality
      - test

  soak:
    stage: Test
    description: "Run the ignored process-supervision soak suite"
    presets: [rust]
    steps:
      - run: cargo test -p evin-process --test soak --locked -- --ignored --test-threads=1

  doctor:
    stage: Check
    description: "Report contributor prerequisite availability"
    steps:
      - run: cargo run --locked -p esh -- scripts/maintenance/doctor.esh

  bootstrap:
    stage: Build
    description: "Install locked repository dependencies and synchronize hooks"
    steps:
      - run: cargo fetch --locked
      - run: npm ci
      - run: npm --prefix editors/vscode ci
      - run: npx playwright install chromium
      - run: cargo evin-dev sync
