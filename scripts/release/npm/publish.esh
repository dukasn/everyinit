set -euo pipefail

assert [ "$#" -eq 1 ] "usage: publish.esh <version>"
VERSION="$1"
assert "echo '$VERSION' | grep -Eq '^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$'" -- "a valid release version is required"
assert [ -f packages/everyinit/package.json ] "run this script from the repository root"

# npm CLI 11 is required for npmjs trusted publishing. Run it from this isolated
# package copy so the workspace's pinned npm 10 devEngines does not reject it.
PACKAGE_DIR="${RUNNER_TEMP:-target}/everyinit-github-package"
rm -rf "$PACKAGE_DIR"
mkdir -p "$(dirname "$PACKAGE_DIR")"
cp -R packages/everyinit "$PACKAGE_DIR"
test -f "$PACKAGE_DIR/package.json"
cd "$PACKAGE_DIR"
echo "Publishing with npm $(npm --version)"

if npm view "everyinit@$VERSION" version --registry=https://registry.npmjs.org >/dev/null 2>&1; then
  echo "everyinit@$VERSION is already on npmjs; skipping publish"
else
  npm publish . --access public --provenance --registry=https://registry.npmjs.org --loglevel=verbose
fi

npm pkg set name=@dukasn/everyinit
# `access: public` is an npmjs publish setting; GitHub Packages visibility is
# managed by GitHub and new packages start private.
npm pkg delete publishConfig.access

if npm view "@dukasn/everyinit@$VERSION" version --registry=https://npm.pkg.github.com >/dev/null 2>&1; then
  echo "@dukasn/everyinit@$VERSION is already on GitHub Packages; skipping publish"
else
  npm publish . --registry=https://npm.pkg.github.com
fi
