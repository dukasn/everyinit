set -e

if test "$#" -eq 0; then set -- dist/mirror; fi
CONFIG="infra/mirror/wrangler.toml"
COUNT=0

for ROOT; do
  assert [ -d "$ROOT" ] "$ROOT is missing; generate release metadata before seeding local R2"
  for FILE in $(glob "$ROOT/**"); do
    if ! test -f "$FILE"; then continue; fi
    KEY=$(path -r "$FILE" "$ROOT")
    corepack npm exec -- wrangler r2 object put "everyinit-artifacts/$KEY" --file "$FILE" --local --config "$CONFIG"
    COUNT=$((COUNT + 1))
  done
done

assert [ "$COUNT" -gt 0 ] "No mirror objects were found; generate release metadata before seeding local R2"
echo "Seeded $COUNT objects into local R2 bucket everyinit-artifacts"
