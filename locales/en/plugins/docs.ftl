# Documentation data action messages

docs-reference-prefix-invalid = reference_prefix must contain only ASCII letters and digits
docs-i18n-locales-required = i18n.locales must contain at least one locale
docs-i18n-locale-invalid = i18n locale '{ $locale }' is not a valid language tag
docs-i18n-locale-noncanonical = i18n locale '{ $locale }' must use canonical language-tag casing
docs-i18n-locale-duplicate = i18n.locales contains duplicate locale '{ $locale }'
docs-i18n-default-locale-invalid = i18n.default_locale is not a valid language tag
docs-i18n-default-locale-noncanonical = i18n.default_locale must use canonical language-tag casing
docs-i18n-default-locale-missing = i18n.default_locale must be included in i18n.locales
docs-latest-version-requires-version-list = latest_version must be omitted when versions is empty
docs-version-id-invalid = version id '{ $version }' must be a path-safe identifier
docs-version-id-duplicate = versions contains duplicate id '{ $version }'
docs-latest-version-required = latest_version is required when versions is configured
docs-latest-version-unlisted = latest_version '{ $version }' is not listed in versions
docs-output-path-must-not-be-empty = out must not be empty
docs-invalid-media = Invalid media { $label } in '{ $slug }': { $requirement }
docs-broken-alias-anchor = Broken anchor in '{ $slug }': reference alias '{ $alias }' has no anchor '#{ $anchor }'
docs-broken-formal-link = Broken link in '{ $slug }': formal reference '{ $alias }' not found
docs-broken-anchor = Broken anchor in '{ $slug }': anchor '#{ $anchor }' not found
docs-svgbob-box-width-mismatch = Svgbob box column width mismatch in '{ $diagram }' ({ $source }) at line { $line }: expected width { $expected }, found { $actual }. Box starting at line { $box_start_line } will render with broken borders.
docs-svgbob-unpaired-quote = Unpaired double quote detected on line { $line } of Svgbob diagram '{ $diagram }' ({ $source }). An odd quote count swallows the closing '|' border into string mode.
docs-invalid-latex-math = Invalid LaTeX math expression in '{ $source }': { $error }. Source: '{ $latex }'
docs-source-directory-description = documentation source directory
docs-asset-directory-description = configured documentation asset directory
docs-local-image-description = local image '{ $reference }'
docs-asset-dir-outside-source = asset_dir must resolve inside source_dir
docs-local-image-output-collision = local image references '{ $first }' and '{ $second }' both publish to '{ $output }'
docs-generated-media-directory-create-failed = failed to create generated media directory '{ $path }': { $error }
docs-local-image-publish-failed = failed to publish local image '{ $path }': { $error }
docs-stale-generated-image-prune-failed = failed to prune stale generated image '{ $path }': { $error }
docs-asset-dir-invalid = asset_dir must be a non-empty path relative to source_dir without '..'
docs-local-image-reference-outside-assets = local image reference '{ $reference }' escapes or is outside the asset directory
docs-local-image-reference-must-be-file = local image reference '{ $reference }' must name a file inside the asset directory
docs-local-image-extension-missing = local image '{ $reference }' has no supported extension
docs-local-image-extension-unsupported = local image '{ $reference }' uses unsupported extension '.{ $extension }' (use PNG, JPEG, AVIF, or SVG)
docs-local-image-read-failed = failed to read local image '{ $reference }': { $error }
docs-local-image-invalid-raster = invalid raster image '{ $reference }': { $error }
docs-local-image-avif-encode-failed = failed to encode local image '{ $reference }' as AVIF: { $error }
docs-path-resolve-failed = failed to resolve { $description } '{ $path }': { $error }
docs-asset-directory-read-failed = failed to read asset directory '{ $path }': { $error }
docs-asset-inspection-failed = failed to inspect asset: { $error }
docs-generated-media-read-failed = failed to read generated media '{ $path }': { $error }
docs-generated-media-inspection-failed = failed to inspect generated media: { $error }
docs-source-discovery-failed = Could not discover documentation sources: { $error }
docs-source-read-failed = Failed to read documentation source '{ $path }': { $error }
docs-source-parse-failed = Failed to parse documentation source: { $error }
docs-strict-root-index-reference = The root index cannot be a formal reference
docs-strict-filename-extension = Strict documentation filenames must use .md or .rst
docs-strict-filename-requires-section = Only the root index may live outside a section
docs-strict-filename-invalid-utf8 = Documentation filename is not valid UTF-8
docs-strict-filename-format = Use <order>.<kebab-case-slug>[.<reference-digits>].<md|rst>
docs-strict-navigation-order-too-large = Navigation order is too large
docs-strict-section-index-name = Section overviews must use 00.index.md or 00.index.rst; order zero is reserved
docs-strict-navigation-order-duplicate = Navigation order { $order } in section '{ $section }' is duplicated
docs-strict-reference-digits-mismatch = Formal reference filename digits do not match its identifier
docs-strict-reference-suffix-invalid = A .NNNN filename suffix must compile as a formal reference
docs-strict-reference-suffix-required = Formal references must end in .NNNN before the extension
docs-output-directory-create-failed = Failed to create '{ $path }': { $error }
docs-data-serialization-failed = Failed to serialize docs data: { $error }
docs-output-write-failed = Failed to write '{ $path }': { $error }
docs-default-locale-pages-missing = No documentation pages found for default locale '{ $locale }' in '{ $path }'
docs-generated-route-ambiguous = Generated route '{ $route }' is ambiguous
docs-translation-missing = No '{ $requested_locale }' translation exists for '{ $page }'; using '{ $content_locale }' content
docs-search-index-write-failed = Failed to write '{ $path }': { $error }
docs-invalid-config = Invalid docs configuration: { $error }
docs-temporary-output-prepare-failed = Failed to prepare temporary docs data: { $error }
