#!evin/v1
module:
  name: docs

values:
  site_title: "Everyinit — Evin & ESH"
  site_url: "https://everyinit.dev/"

tasks:
  evin-catalog:
    stage: Docs
    description: "Generate the tracked Evin configuration catalog intentionally"
    needs: [main:build]
    steps:
      - uses: evin/docs@v1
        with:
          target: lsp
          title: "${site_title}"
          site_url: "${site_url}"
          source_dir: docs/reference
          include:
            - 20.workspace-configuration.4500.md
            - 30.module-configuration.4510.md
            - 35.namespace-configuration.4515.md
            - 40.environment-configuration.4520.md
            - 50.git-rules-configuration.4530.md
            - actions/10.documentation-action.5100.md
            - actions/20.archive-action.5110.md
            - actions/30.changelog-action.5120.md
            - actions/40.git-release-action.5130.md
            - actions/50.version-bumper-action.5140.md
            - actions/60.ci-action.5150.md
            - actions/70.review-request-action.5160.md
          out: crates/evin/assets/config-catalog.json

  catalog:
    stage: Docs
    description: "Generate the tracked ESH runtime catalog intentionally"
    needs: [main:build]
    steps:
      - uses: evin/docs@v1
        with:
          target: lsp
          title: "${site_title}"
          site_url: "${site_url}"
          source_dir: docs/reference/esh
          include: [100.runtime-reference.3010.md]
          out: crates/esh/assets/builtins-catalog.json

  build:
    stage: Docs
    description: "Generate the static documentation site and audit links"
    needs: [main:build]
    on:
      hooks: [pre-commit]
    steps:
      - uses: evin/docs@v1
        with:
          title: "${site_title}"
          site_url: "${site_url}"
          strict_filenames: true
          metrics: true
          metrics_budget_kb: 110

  test-responsive:
    stage: Docs
    description: "Run Chromium documentation responsiveness checks"
    cwd: .
    needs: [build]
    steps:
      - run: npx playwright test

  verify:
    stage: Docs
    description: "Build and validate documentation in Chromium"
    needs: [test-responsive]

  serve:
    stage: Docs
    description: "Serve the live-reloading documentation site"
    needs: [main:build]
    watch:
      paths:
        - crates/**
        - builtins/**
        - Cargo.toml
        - Cargo.lock
      debounce: 300ms
    steps:
      - uses: evin/docs@v1
        with:
          mode: serve
          title: "${site_title}"
          site_url: "${site_url}"
          strict_filenames: true
          metrics: true
          metrics_budget_kb: 110
