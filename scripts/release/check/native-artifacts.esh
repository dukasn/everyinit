set -e

assert [ "$#" -eq 3 ] "usage: native-artifacts.esh <evin|esh> <version> <artifact-root>"
PACKAGE="$1"
VERSION="$2"
ARTIFACT_ROOT="$3"
case "$PACKAGE" in
  evin|esh)
    ;;
  *)
    echo "unsupported release package: $PACKAGE" >&2
    exit 1
    ;;
esac
assert [ -n "$VERSION" ] "release version must not be empty"

DEB=$(glob "$ARTIFACT_ROOT/${PACKAGE}_${VERSION}-*_amd64.deb")
APK=$(glob "$ARTIFACT_ROOT/${PACKAGE}-${VERSION}-r*.apk")
ARCH=$(glob "$ARTIFACT_ROOT/${PACKAGE}-${VERSION}-*-x86_64.pkg.tar.zst")
assert [ "$(printf '%s\n' "$DEB" | wc -l)" -eq 1 ] "expected one ${PACKAGE} DEB artifact for $VERSION"
assert [ "$(printf '%s\n' "$APK" | wc -l)" -eq 1 ] "expected one ${PACKAGE} APK artifact for $VERSION"
assert [ "$(printf '%s\n' "$ARCH" | wc -l)" -eq 1 ] "expected one ${PACKAGE} Arch artifact for $VERSION"
assert [ -s "$DEB" ] "${PACKAGE} DEB artifact is empty"
assert [ -s "$APK" ] "${PACKAGE} APK artifact is empty"
assert [ -s "$ARCH" ] "${PACKAGE} Arch artifact is empty"

echo "Verified ${PACKAGE} DEB, APK, and Arch artifacts for $VERSION"
