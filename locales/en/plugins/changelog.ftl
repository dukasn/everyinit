changelog-section-missing = Missing or empty changelog section for { $section }
changelog-template-resolution-failed = Could not resolve changelog template: { $error }
changelog-dry-run-skipped-generation = changelog generation bypassed in dry-run

git-execution-failed-title = Git Error
