    "pages:dev": "cargo evin-dev run infra:dev:pages",
    "installer:dev": "cargo evin-dev run infra:dev:installer",
    "mirror:dev": "cargo evin-dev run infra:dev:mirror",
    "mirror:seed": "cargo evin-dev run infra:mirror:seed",
    "infra:quality:types": "cargo evin-dev run infra:quality:types",
    "infra:quality:fmt": "cargo evin-dev run infra:quality:fmt",
    "infra:quality:lint": "cargo evin-dev run infra:quality:lint",
    "infra:quality:typecheck": "cargo evin-dev run infra:quality:typecheck",
    "infra:quality:build": "cargo evin-dev run infra:quality:build",
    "infra:quality:verify": "cargo evin-dev run infra:quality:verify",
    "infra:deploy:workers": "cargo evin-dev run infra:deploy:workers",
