#!/usr/bin/env esh
set -e

assert [ "$#" -eq 2 ] "usage: verify-binaries.esh <target-triple> <version>"
TARGET="$1"
VERSION="$2"
EVIN_BIN="target/$TARGET/release/evin"
ESH_BIN="target/$TARGET/release/esh"

assert [ -x "$EVIN_BIN" ] "missing executable EVIN binary: $EVIN_BIN"
assert [ -x "$ESH_BIN" ] "missing executable ESH binary: $ESH_BIN"
assert "! readelf -l $EVIN_BIN | grep -Fq 'Requesting program interpreter'" -- "EVIN binary must be statically linked"
assert "! readelf -l $ESH_BIN | grep -Fq 'Requesting program interpreter'" -- "ESH binary must be statically linked"
assert "target/$TARGET/release/evin --version | grep -Fq '$VERSION'" -- "EVIN binary version does not match $VERSION"
assert "target/$TARGET/release/esh --version | grep -Fq '$VERSION'" -- "ESH binary version does not match $VERSION"
