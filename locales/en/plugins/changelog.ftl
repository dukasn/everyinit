# Changelog plugin locale messages

git-execution-failed = Failed to execute git: { $error }
file-write-failed = Failed to write to '{ $path }': { $error }
changelog-path-must-not-be-empty = path must not be empty
unreleased-heading-must-not-be-empty = unreleased_heading must not be empty
sections-keys-must-not-be-empty = sections keys must not be empty
version-must-not-be-empty = version must not be empty
version-is-required-when-include-unreleased-is-false = version is required when include_unreleased is false
missing-workspace-name = Missing workspace name
notes-path-must-not-be-empty-when-provided = notes_path must not be empty when provided
section-must-be-non-empty-and-requires-notes-path = section must be non-empty and requires notes_path
section-template-invalid = section contains invalid template syntax: { $error }
label-must-not-be-empty-when-provided = label must not be empty when provided
label-template-invalid = label contains invalid template syntax: { $error }
changelog-file-read-failed = Failed to read changelog '{ $path }': { $error }
changelog-section-template-invalid = Invalid section template: { $error }
changelog-section-empty = Changelog section must not be empty
changelog-section-paths-must-differ = Changelog and notes paths must differ
