          "require_tracking_for": [
            ".psd",
            ".mp4",
            ".zip",
            ".tar.gz",
            ".mov"
          ]
        }
      }
    },
    "name": {
      "default": "Default Repository Policy",
      "type": "string"
    },
    "pull_requests": {
      "anyOf": [
        {
          "$ref": "#/$defs/PullRequestsNamespace"
        },
        {
          "type": "null"
        }
      ],
      "default": {
        "policies": {
          "block_wip_prefixes": [
            "WIP:",
            "DRAFT:"
          ],
          "require_assignee": false,
          "require_linked_issue": false
        },
        "title_format": "{type}({scope}?): {description}"
      }
    },
    "releases": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleasesNamespace"
        },
        {
          "type": "null"
        }
      ],
      "default": {
        "change_types": {
          "build": {
            "bump": "patch",
            "changelog_section": "Miscellaneous"
          },
          "chore": {
            "bump": "patch",
            "changelog_section": "Miscellaneous"
          },
          "ci": {
            "bump": "none",
            "changelog_section": "Miscellaneous"
          },
          "docs": {
            "bump": "patch",
            "changelog_section": "Documentation"
          },
          "feat": {
            "bump": "minor",
            "changelog_section": "Features"
          },
          "fix": {
            "bump": "patch",
            "changelog_section": "Bug Fixes"
          },
          "perf": {
            "bump": "patch",
            "changelog_section": "Performance Improvements"
          },
          "refactor": {
            "bump": "patch",
            "changelog_section": "Refactoring"
          },
          "test": {
            "bump": "none",
            "changelog_section": "Miscellaneous"
          }
        },
        "changelog": {
          "host_integration": null,
          "ticket_linking": null
        },
        "commit_message": "chore(release): {version}",
        "packages": {},
        "policies": {
          "breaking_change_bump": "major",
          "pre_release_prefix": "rc"
        },
        "prerelease": {
          "channels": {
            "alpha": "alpha.{n}",
            "beta": "beta.{n}",
            "canary": "canary.{n}",
            "dev": "dev.{n}",
            "nightly": "nightly.{n}",
            "preview": "preview.{n}",
            "rc": "rc.{n}",
            "test": "test.{n}"
          },
          "start_at_one": false
        },
        "versioning": {
          "strategy": "semver"
        }
      }
    },
    "remotes": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemotesNamespace"
        },
        {
          "type": "null"
        }
      ],
      "default": {
        "policies": {
          "allowed_push_remotes": [
            "origin"
          ],
          "block_force_push": [
            "main",
            "master"
          ],
          "require_up_to_date": true
        }
      }
    },
    "submodules": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubmodulesNamespace"
        },
        {
          "type": "null"
        }
      ],
      "default": {
        "policies": {
          "allow_creation": false,
          "allowed_hosts": []
        }
      }
    },
    "tags": {
      "anyOf": [
        {
          "$ref": "#/$defs/TagsNamespace"
        },
        {
          "type": "null"
        }
      ],
      "default": {
        "name_format": "v{version}",
        "policies": {
          "block_deletion": true,
          "require_annotated": true
        }
      }
    }
  },
  "required": [
    "$schema"
  ],
  "title": "RepositoryPolicy",
  "type": "object"
}
