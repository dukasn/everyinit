{
  "remotes": {
    "policies": {
      "allowed_push_remotes": [
        "origin"
      ],
      "block_force_push": [],
      "require_up_to_date": false
    }
  },
  "name": "Repository Development Standard (Canary)",
  "commits": {
    "message_format": [
      "{type}({scope}?){breaking?}: {description}",
      "{type}: {description}"
    ],
    "ignore_patterns": [
      "^Merge branch",
      "^Revert"
    ],
    "fields": {
      "type": {
        "allowed_values": [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "build",
          "ci",
          "chore",
          "revert"
        ],
        "must_be": "lowercase-with-hyphens"
      },
      "description": {
        "max_length": 72
      }
    },
    "policies": {
      "require_body": false,
      "require_ticket_reference": false
    }
  },
  "releases": {
    "versioning": {
      "strategy": "cargo"
    },
    "change_types": {
      "feat": {
        "bump": "minor",
        "changelog_section": "Features"
      },
      "fix": {
        "bump": "patch",
        "changelog_section": "Bug Fixes"
      },
      "chore": {
        "bump": "patch",
        "changelog_section": "Maintenance"
      },
      "test": {
        "bump": "patch",
        "changelog_section": "Tests"
      },
      "docs": {
        "bump": "patch",
        "changelog_section": "Documentation"
      },
      "refactor": {
        "bump": "patch",
        "changelog_section": "Refactoring"
      },
      "perf": {
        "bump": "patch",
        "changelog_section": "Performance Improvements"
      }
    },
    "commit_message": "chore(release): {version}",
    "prerelease": {
      "channels": {
        "canary": "canary.{n}"
      }
    },
    "packages": {
      "evin": {
        "watch": [
          "Cargo.lock",
          "crates/**",
          "builtins/**",
          "locales/**",
          "scripts/release/**",
          ".evin/policy.json",
          ".evin/release.flow",
          ".evin/release/**",
          "LICENSE",
          "THIRD_PARTY_NOTICES.md",
          "LICENSES/**"
        ],
        "targets": [
          "deb",
          "apk",
          "arch"
        ],
        "revision": {
          "scope": "target"
        }
      },
      "esh": {
        "watch": [
          "Cargo.lock",
          "crates/**",
          "builtins/**",
          "locales/**",
          "scripts/release/**",
          ".evin/policy.json",
          ".evin/release.flow",
          ".evin/release/**",
          "LICENSE",
          "THIRD_PARTY_NOTICES.md",
          "LICENSES/**"
        ],
        "targets": [
          "deb",
          "apk",
          "arch"
        ],
        "revision": {
          "scope": "target"
        }
      },
      "vscode": {
        "watch": [
          "editors/vscode/**",
          "LICENSE"
        ],
        "targets": [
          "vsix"
        ],
        "revision": {
          "scope": "package"
        }
      }
    }
  },
  "branches": {
    "name_format": [
      "{type}/{ticket}-{description}",
      "{type}/{description}"
    ],
    "fields": {
      "type": {
        "allowed_values": [
          "feat",
          "fix",
          "chore",
          "docs",
          "refactor",
          "release"
        ],
        "must_be": "lowercase-with-hyphens"
      },
      "description": {
        "must_be": "lowercase-with-hyphens"
      }
    },
    "policies": {
      "block_push_to_main": false
    }
  },
  "tags": {
    "name_format": "v{version}",
    "policies": {
      "require_annotated": true,
      "block_deletion": true
    }
  },
  "pull_requests": {
    "title_format": "{type}({scope}?): {description}",
    "policies": {
      "require_assignee": false,
      "require_linked_issue": false,
      "block_wip_prefixes": [
        "WIP:",
        "draft:",
        "wip:"
      ]
    }
  },
  "files": {
    "naming_convention": null,
    "ignore": [],
    "content_rules": [
      {
        "name": "rust-license-header",
        "include": [
          "*.rs",
          "**/*.rs"
        ],
        "require_pattern": "(?m)^// Copyright \\(C\\)",
        "error_message": "Rust source file missing required license header."
      }
    ],
    "policies": {
      "block_paths": []
    }
  },
  "lfs": {
    "policies": {
      "require_tracking_for": [
        ".psd",
        ".mp4",
        ".zip",
        ".tar.gz",
        ".mov"
      ],
      "require_lfs_installed": false
    }
  },
  "submodules": {
    "policies": {
      "allow_creation": false,
      "allowed_hosts": []
    }
  },
  "$schema": "https://dl.everyinit.dev/schema/v1/policy"
}
