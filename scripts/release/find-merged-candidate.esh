set -e
assert [ "$#" -eq 2 ] "usage: find-merged-candidate.esh <before-sha> <after-sha>"
BEFORE="$1"
AFTER="$2"
if echo "$BEFORE" | grep -Eq '^0+$'; then COMMITS=$(git rev-list "$AFTER"); else COMMITS=$(git rev-list "$AFTER" "^$BEFORE"); fi
TAG=""
COMMIT=""
for CANDIDATE in $(git tag --list 'v*'); do
  if ! echo "$CANDIDATE" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'; then continue; fi
  TARGET=$(git rev-parse "${CANDIDATE}^{commit}")
  if ! echo "$COMMITS" | grep -Eq "^${TARGET}$"; then continue; fi
  assert [ -z "$TAG" ] "main update contains multiple release tags: $TAG, $CANDIDATE"
  TAG="$CANDIDATE"
  COMMIT="$TARGET"
done
if test -n "$TAG"; then FOUND=true; VERSION="${TAG#v}"; else FOUND=false; VERSION=""; fi
echo "{\"found\":$FOUND,\"tag\":\"$TAG\",\"version\":\"$VERSION\",\"commit\":\"$COMMIT\"}"
if test -n "$GITHUB_OUTPUT"; then printf 'found=%s\ntag=%s\nversion=%s\ncommit=%s\n' "$FOUND" "$TAG" "$VERSION" "$COMMIT" >> "$GITHUB_OUTPUT"; fi
