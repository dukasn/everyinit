#!evin/v1
namespace:
  name: release
  description: "Release engineering and distribution pipelines"

tasks:
  doctor:
    stage: Publish
    description: "Report Linux musl release prerequisite availability"
    steps:
      - run: cargo run --locked -p esh -- scripts/release/doctor.esh

  rehearsal-start:
    stage: Publish
    description: "Record repository status before generating the release rehearsal"
    steps:
      - run: node scripts/release/verify-rehearsal-clean.mjs --snapshot

  changelog-rehearsal:
    stage: Publish
    description: "Generate and verify the candidate changelog in ignored output"
    env: [RELEASE_VERSION]
    needs: [release:rehearsal-start]
    steps:
      - uses: evin/changelog@v1
        with:
          path: target/release-rehearsal/CHANGELOG.md
          version: "${env.RELEASE_VERSION}"
      - run: node scripts/release/verify-changelog.mjs target/release-rehearsal/CHANGELOG.md "$RELEASE_VERSION"

  distribution-rehearsal:
    stage: Publish
    description: "Build and verify all Evin and ESH distribution formats without publishing"
    env: [RELEASE_TARGET, RELEASE_VERSION]
    needs:
      - release:changelog-rehearsal
      - evin:package:distribution-verify
      - esh:package:distribution-verify
    steps:
      - run: node scripts/release/verify-rehearsal-clean.mjs

  bump:
    stage: Publish
    description: "Calculate and apply the next canary version"
    steps:
      - uses: evin/version-bumper@v1
        with:
          initial_version: "1.0.0-canary.100"
          channel: canary
          require_change: false
          files:
            - "Cargo.toml"
            - path: ".evin/workspace.flow"
              match: 'version:\s*"${previous_version}"'
              write: 'version: "${version}"'
          git:
            commit: true
            tag: true
            defer: true
      - run: cargo update --workspace
      - run: cargo check --workspace --locked

  changelog:
    stage: Publish
    description: "Generate the canonical changelog section"
    needs:
      - release:bump
    steps:
      - uses: evin/changelog@v1
        with:
          path: CHANGELOG.md
          version: ${release:bump.version}
          notes_path: target/release-notes.md
      - run: node scripts/release/verify-changelog.mjs CHANGELOG.md "$(node scripts/release/workspace-version.mjs)"

  prepare:
    stage: Publish
    description: "Commit and tag the prepared source release"
    needs:
      - release:changelog
      - release:bump
    steps:
      - run: git add Cargo.toml Cargo.lock .evin/workspace.flow .evin/release-lock.yaml CHANGELOG.md
      - uses: evin/git-release@v1
        with:
          stage: existing
          message: |-
            chore(release): ${release:bump.version}
          tag: "${release:bump.tag}"

  propose:
    stage: Publish
    description: "Publish the release branch and keep one release pull request in sync with it"
    env: [GITHUB_TOKEN, RELEASE_BRANCH]
    needs:
      - release:changelog
      - release:bump
    steps:
      - run: git add Cargo.toml Cargo.lock .evin/workspace.flow .evin/release-lock.yaml CHANGELOG.md
      - uses: evin/git-release@v1
        with:
          stage: existing
          enabled: ${release:bump.changed}
          message: |-
            chore(release): ${release:bump.version}
          tag: "${release:bump.tag}"
          push:
            branch: "${env.RELEASE_BRANCH}"
            force: true
            prune_stale_tags: true
            base: main
      - uses: evin/review-request@v1
        with:
          branch: "${env.RELEASE_BRANCH}"
          base: main
          wanted: ${release:bump.changed}
          title: "chore(release): ${release:bump.tag}"
          body_path: target/release-notes.md
          commands:
            find: gh pr list --head "$EVIN_REVIEW_BRANCH" --base "$EVIN_REVIEW_BASE" --state open --json number --jq '.[0].number // empty'
            create: |-
              gh label create release-candidate --color 0e8a16 --force
              gh pr create --head "$EVIN_REVIEW_BRANCH" --base "$EVIN_REVIEW_BASE" --title "$EVIN_REVIEW_TITLE" --body-file "$EVIN_REVIEW_BODY_FILE" --label release-candidate
            update: gh pr edit "$EVIN_REVIEW_ID" --title "$EVIN_REVIEW_TITLE" --body-file "$EVIN_REVIEW_BODY_FILE"
            close: gh pr close "$EVIN_REVIEW_ID" --delete-branch --comment "Nothing left to release."

  tag-verify:
    stage: Publish
    description: "Verify the tag and shared workspace version"
    env: [RELEASE_TAG, RELEASE_VERSION]
    needs:
      - test
    steps:
      - run: cargo run --locked -p esh -- scripts/release/verify-tag.esh "$RELEASE_TAG" "$RELEASE_VERSION"

  candidate-validate:
    stage: Publish
    description: "Validate a tagged release candidate before it can merge"
    env: [RELEASE_BASE_SHA, RELEASE_COMMIT, RELEASE_TAG, RELEASE_VERSION]
    steps:
      - run: node scripts/release/validate-candidate.mjs "$RELEASE_TAG" "$RELEASE_VERSION" "$RELEASE_COMMIT" "$RELEASE_BASE_SHA"

  package-state:
    stage: Publish
    description: "Resolve package revisions without changing the checkout"
    env: [RELEASE_VERSION]
    steps:
      - uses: evin/version-bumper@v1
        with:
          initial_version: "1.0.0-canary.100"
          read_only: true
          fixed_version: "${env.RELEASE_VERSION}"

  package:
    stage: Publish
    description: "Build all GitHub release formats for Evin and ESH"
    needs:
      - release:tag-verify
      - evin:package:github
      - esh:package:github

  package-cloudflare:
    stage: Publish
    description: "Build only the tar.gz artifacts used by the Cloudflare mirror"
    needs:
      - release:tag-verify
      - evin:package:cloudflare
      - esh:package:cloudflare

  package-cloudflare-verify:
    stage: Publish
    description: "Verify the tar.gz artifacts used by the Cloudflare mirror"
    needs:
      - release:package-cloudflare
      - evin:package:cloudflare-verify
      - esh:package:cloudflare-verify

  package-verify:
    stage: Publish
    description: "Verify both release archives"
    needs:
      - release:package
      - evin:package:github-verify
      - esh:package:github-verify

  publish-prebuilt:
    stage: Publish
    description: "Publish the prebuilt release and move the canary mirror pointers last"
    needs: [infra:mirror:publish-pointers]

  github-publish:
    stage: Publish
    description: "Reconcile and publish the release through Evin CI actions"
    env: [GITHUB_REPOSITORY, GITHUB_TOKEN, GITHUB_API_URL, GITHUB_STEP_SUMMARY, RELEASE_TAG, RELEASE_VERSION]
    needs:
      - release:package-verify
      - infra:mirror:metadata
    steps:
      - run: node scripts/release/github-ci.mjs snapshot "$RELEASE_TAG"
      - uses: evin/ci@v1
        with:
          tag: "${env.RELEASE_TAG}"
          title: "${env.RELEASE_TAG}"
          state: .evin/actions/ci/remote-state.v1.json
          plan_out: .evin/actions/ci/evin-plan.v1.json
          notes_dir: .evin/actions/ci/notes/evin
          artifacts_dir: crates/evin/dist/github
          changelog: CHANGELOG.md
      - run: node scripts/release/github-ci.mjs apply .evin/actions/ci/evin-plan.v1.json
      - run: node scripts/release/github-ci.mjs snapshot "$RELEASE_TAG"
      - uses: evin/ci@v1
        with:
          tag: "${env.RELEASE_TAG}"
          title: "${env.RELEASE_TAG}"
          state: .evin/actions/ci/remote-state.v1.json
          plan_out: .evin/actions/ci/esh-plan.v1.json
          notes_dir: .evin/actions/ci/notes/esh
          artifacts_dir: crates/esh/dist/github
          changelog: CHANGELOG.md
      - run: node scripts/release/github-ci.mjs apply .evin/actions/ci/esh-plan.v1.json
      - run: node scripts/release/github-ci.mjs summary "$RELEASE_TAG"

  github-publish-prebuilt:
    stage: Publish
    description: "Publish verified downloaded artifacts without rebuilding them"
    env: [GITHUB_REPOSITORY, GITHUB_TOKEN, GITHUB_API_URL, GITHUB_STEP_SUMMARY, RELEASE_TAG]
    needs:
      - infra:mirror:metadata-prebuilt
      - infra:mirror:publish-objects
    steps:
      - run: node scripts/release/github-ci.mjs snapshot "$RELEASE_TAG"
      - uses: evin/ci@v1
        with:
          tag: "${env.RELEASE_TAG}"
          title: "${env.RELEASE_TAG}"
          state: .evin/actions/ci/remote-state.v1.json
          plan_out: .evin/actions/ci/evin-plan.v1.json
          notes_dir: .evin/actions/ci/notes/evin
          artifacts_dir: crates/evin/dist/github
          changelog: CHANGELOG.md
      - run: node scripts/release/github-ci.mjs apply .evin/actions/ci/evin-plan.v1.json
      - run: node scripts/release/github-ci.mjs snapshot "$RELEASE_TAG"
      - uses: evin/ci@v1
        with:
          tag: "${env.RELEASE_TAG}"
          title: "${env.RELEASE_TAG}"
          state: .evin/actions/ci/remote-state.v1.json
          plan_out: .evin/actions/ci/esh-plan.v1.json
          notes_dir: .evin/actions/ci/notes/esh
          artifacts_dir: crates/esh/dist/github
          changelog: CHANGELOG.md
      - run: node scripts/release/github-ci.mjs apply .evin/actions/ci/esh-plan.v1.json
      - run: node scripts/release/github-ci.mjs summary "$RELEASE_TAG"
