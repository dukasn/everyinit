set -euo pipefail

COUNT="$(gh api --paginate "repos/$GITHUB_REPOSITORY/commits/$RELEASE_COMMIT/pulls?per_page=100" --jq '.[]' | jq -s '[.[] | select(.base.ref == "main" and .head.ref == env.RELEASE_BRANCH and .head.repo.full_name == env.GITHUB_REPOSITORY and .merged_at != null and .merge_commit_sha == env.RELEASE_COMMIT)] | length')"
if [ "$COUNT" -gt 1 ]; then
  echo 'Ambiguous release proposal' >&2
  exit 1
fi
echo "merged=$COUNT" >> "$GITHUB_OUTPUT"
