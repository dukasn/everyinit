set -e

CARGO_VERSION=$(grep -E '^version[[:space:]]*=' Cargo.toml | head -n 1 | cut -d '"' -f 2)
FLOW_VERSION=$(grep -E '^[[:space:]]+version:[[:space:]]*"' .evin/workspace.flow | head -n 1 | cut -d '"' -f 2)
VSCODE_VERSION=$(json -g version editors/vscode/package.json)

assert [ -n "$CARGO_VERSION" ] "workspace version is missing from Cargo.toml"
assert [ -n "$FLOW_VERSION" ] "workspace version is missing from .evin/workspace.flow"
assert [ "$CARGO_VERSION" = "$FLOW_VERSION" ] "workspace versions do not match (Cargo.toml=$CARGO_VERSION, .evin/workspace.flow=$FLOW_VERSION)"
assert [ -n "$VSCODE_VERSION" ] "workspace version is missing from editors/vscode/package.json"
assert [ "$CARGO_VERSION" = "$VSCODE_VERSION" ] "workspace versions do not match (Cargo.toml=$CARGO_VERSION, editors/vscode/package.json=$VSCODE_VERSION)"

if echo "$CARGO_VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'; then
  echo "$CARGO_VERSION"
else
  echo "workspace version is not a supported release version: $CARGO_VERSION" >&2
  exit 1
fi
