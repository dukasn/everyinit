            "allowed_values": [
              "feat",
              "fix",
              "chore",
              "docs",
              "refactor",
              "perf",
              "test",
              "ci",
              "build"
            ],
            "max_length": null,
            "must_be": null,
            "pattern": null
          }
        },
        "ignore_patterns": [
