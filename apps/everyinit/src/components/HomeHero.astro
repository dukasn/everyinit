---
import { renderHighlightedCode } from "../lib/render-doc";
import { createTranslator } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = createTranslator(locale);

const heroCode = `#!evin/v1
workspace:
  name: storefront
  execution: linear

stages: [Check, Test]

tasks:
  lint:
    stage: Check
    run: npm run lint

  test:
    stage: Test
    needs: [lint]
    run: npm test`;
---

    <section class="mx-auto grid max-w-7xl gap-14 px-5 pb-24 pt-12 sm:px-8 sm:pt-20 lg:grid-cols-[1.03fr_.97fr] lg:items-center lg:px-12 lg:pb-32 lg:pt-24">
      <div class="max-w-2xl">
        <p class="mb-7 inline-flex items-center gap-2 rounded-full border border-[#d8dfcf] bg-white/60 px-3.5 py-2 text-xs font-medium tracking-wide text-moss">
          <span class="size-2 rounded-full bg-[#78a467]"></span>
          {t("home-hero-eyebrow")}
        </p>
        <h1 class="max-w-[12ch] text-[clamp(2.6rem,8vw,6.6rem)] font-semibold leading-[.91] tracking-[-.075em] text-ink">
          {t("home-hero-title-first")}<br /><span class="text-moss">{t("home-hero-title-second")}</span>
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-8 text-[#566356] sm:text-xl sm:leading-9">
          {t("home-hero-description")}
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="/docs/book/installation/" class="group inline-flex items-center gap-3 rounded-full bg-ink px-6 py-4 text-sm font-semibold text-paper shadow-[0_12px_28px_-16px_#18211b] transition hover:-translate-y-0.5 hover:bg-moss active:scale-[.98]">
            {t("home-hero-install")} <span class="text-lime motion-safe:transition-transform motion-safe:duration-200 group-hover:translate-x-1" aria-hidden="true">↗</span>
          </a>
          <a href="https://github.com/dukasn/everyinit" class="group inline-flex items-center gap-2 rounded-full border border-[#cfd5ca] px-6 py-4 text-sm font-semibold text-ink transition hover:border-moss hover:bg-white/70 active:scale-[.98]">
            {t("home-hero-explore")} <span class="motion-safe:transition-transform motion-safe:duration-200 group-hover:translate-x-1" aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="mt-5 text-xs leading-5 text-moss">{t("home-hero-availability")}</p>
      </div>

      <div class="relative mx-auto w-full max-w-[590px] lg:ml-auto">
        <div class="home-hero-backdrop absolute -inset-2 rotate-0 rounded-[2rem] bg-[#e2e7d8] sm:-inset-4 sm:-rotate-2"></div>
        <div class="relative overflow-hidden rounded-[1.5rem] border border-[#334337] bg-[#17211a] shadow-[0_30px_90px_-35px_rgba(22,34,24,.55)] transition-[border-color,box-shadow] duration-300 hover:border-[#65765d] hover:shadow-[0_36px_100px_-35px_rgba(22,34,24,.68)] motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-out motion-safe:hover:-translate-y-1">
          <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
            <div class="flex gap-1.5"><span class="size-2.5 rounded-full bg-[#839278]"></span><span class="size-2.5 rounded-full bg-[#62735c]"></span><span class="size-2.5 rounded-full bg-[#4b5c4b]"></span></div>
            <span class="font-mono text-[11px] text-[#9eac9a]">storefront · evin</span>
            <span class="rounded-full bg-[#25372a] px-2.5 py-1 font-mono text-[10px] text-[#c9e3b9]">{t("home-hero-ready")}</span>
          </div>
          <div class="px-5 py-6 sm:px-7 sm:py-8">
            <p class="font-mono text-xs text-[#a0ae9b]">.evin/workspace.flow</p>
            <pre class="home-hero-code mt-5 overflow-x-auto font-mono text-[12px] leading-[1.9] text-[#e5ebdf] sm:text-[13px]"><code set:html={renderHighlightedCode(heroCode, "flow")}></code></pre>
          </div>
          <div class="border-t border-white/10 bg-[#1d2a20] px-5 py-4 sm:px-7">
            <div class="flex items-center justify-between font-mono text-[11px]">
              <span class="text-[#a7b3a2]">$ evin run test</span><span class="text-[#c3e4a0]">{t("home-hero-passed")}</span>
            </div>
            <div class="mt-3 flex gap-2"><span class="h-1.5 flex-[2] rounded-full bg-[#91b775]"></span><span class="h-1.5 flex-1 rounded-full bg-[#6c8862]"></span><span class="h-1.5 flex-[3] rounded-full bg-[#4b644b]"></span></div>
            <p class="mt-3 font-mono text-[10px] text-[#92a18e]">{t("home-hero-run-summary", { lintTime: "0.42s", testTime: "2.18s" })}</p>
          </div>
        </div>
        <div class="absolute -bottom-7 -left-5 hidden rounded-2xl border border-[#d5ddce] bg-surface px-4 py-3 shadow-lg sm:flex sm:items-center sm:gap-3">
          <span class="grid size-9 place-items-center rounded-full bg-lime text-lg">↳</span>
          <span><span class="block text-xs font-semibold">{t("home-hero-task-graph")}</span><span class="block text-[11px] text-moss">{t("home-hero-channels")}</span></span>
        </div>
      </div>
    </section>
