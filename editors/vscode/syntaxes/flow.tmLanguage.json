{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Evin Flow",
  "scopeName": "source.flow",
  "patterns": [
    {
      "include": "#shebang"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#variable-interpolation"
    },
    {
      "include": "#strings-quoted"
    },
    {
      "include": "#root-sections"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#step-action-run"
    },
    {
      "include": "#step-action-uses"
    },
    {
      "include": "#step-action-with"
    },
    {
      "include": "#stage-property"
    },
    {
      "include": "#needs-property"
    },
    {
      "include": "#path-properties"
    },
    {
      "include": "#enum-properties"
    },
    {
      "include": "#task-definitions"
    },
    {
      "include": "#property-keys"
    },
    {
      "include": "#inline-arrays"
    },
    {
      "include": "#list-item-values"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "shebang": {
      "match": "^#!evin(?:/[^\\r\\n]+)?",
      "name": "comment.line.shebang.flow keyword.control.directive.pragma.flow"
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.flow"
    },
    "variable-interpolation": {
      "match": "(\\$\\{)([a-zA-Z0-9_.-]+)(\\})",
      "captures": {
        "1": {
          "name": "punctuation.definition.variable.begin.flow"
        },
        "2": {
          "name": "variable.other.flow"
        },
        "3": {
          "name": "punctuation.definition.variable.end.flow"
        }
      }
    },
    "root-sections": {
      "match": "^(workspace|module|package|stages|tasks|rules|include|env|values|expose|presets)\\s*(:)",
      "captures": {
        "1": {
          "name": "keyword.other.section.flow entity.name.section.flow"
        },
        "2": {
          "name": "punctuation.separator.key-value.flow"
        }
      }
    },
    "directives": {
      "match": "^\\s*(?:-\\s*)?(steps|on|watch)\\s*(:)",
      "captures": {
        "1": {
          "name": "keyword.control.directive.flow"
        },
        "2": {
          "name": "punctuation.separator.key-value.flow"
        }
      }
    },
    "step-action-run": {
      "begin": "^\\s*(?:(-\\s+))?(run)\\s*(:)\\s*",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.list.begin.flow"
        },
        "2": {
          "name": "entity.name.tag.yaml entity.name.tag.flow keyword.control.step.flow"
        },
        "3": {
          "name": "punctuation.separator.key-value.flow"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#variable-interpolation"
        },
        {
          "include": "#strings-quoted"
        },
        {
          "match": "[^#\\r\\n]+",
          "name": "string.unquoted.command.flow"
        }
      ]
    },
    "step-action-uses": {
      "begin": "^\\s*(?:(-\\s+))?(uses)\\s*(:)\\s*",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.list.begin.flow"
        },
        "2": {
          "name": "entity.name.tag.yaml entity.name.tag.flow keyword.control.step.flow"
        },
        "3": {
          "name": "punctuation.separator.key-value.flow"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#variable-interpolation"
        },
        {
          "include": "#strings-quoted"
        },
        {
          "match": "([a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+@[a-zA-Z0-9_.-]+)",
          "name": "support.class.action.flow entity.name.function.action.flow"
        },
        {
          "match": "[^#\\s\\r\\n]+",
          "name": "string.unquoted.flow"
        }
      ]
    },
    "step-action-with": {
      "match": "^\\s*(with)\\s*(:)",
      "captures": {
        "1": {
          "name": "entity.name.tag.yaml entity.name.tag.flow keyword.control.step.flow"
        },
        "2": {
          "name": "punctuation.separator.key-value.flow"
        }
      }
    },
    "stage-property": {
      "begin": "^\\s*(stage)\\s*(:)\\s*",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.yaml entity.name.tag.flow support.type.property-name.flow"
        },
        "2": {
          "name": "punctuation.separator.key-value.flow"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#variable-interpolation"
        },
        {
          "match": "[a-zA-Z0-9_.-]+",
          "name": "constant.language.enum.flow entity.name.type.enum.flow"
        }
      ]
    },
    "needs-property": {
      "begin": "^\\s*(needs)\\s*(:)\\s*",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.yaml entity.name.tag.flow support.type.property-name.flow"
        },
        "2": {
          "name": "punctuation.separator.key-value.flow"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#inline-arrays"
        },
        {
          "match": "[a-zA-Z0-9_.-]+",
          "name": "variable.other.task-ref.flow"
        }
      ]
    },
    "path-properties": {
      "begin": "^\\s*(path|paths|files|include|exclude|source_dir|output_dir|layout_dir|asset_dir|icon_dir|rules|cwd|out)\\s*(:)\\s*",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.yaml entity.name.tag.flow support.type.property-name.flow"
        },
        "2": {
          "name": "punctuation.separator.key-value.flow"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#variable-interpolation"
        },
        {
          "include": "#inline-arrays"
        },
        {
          "include": "#strings-quoted"
        },
        {
          "match": "[^#\\s\\[\\]]+",
          "name": "string.unquoted.path.flow"
        }
      ]
    },
    "enum-properties": {
      "begin": "^\\s*(execution|format|layout|channel|bump|scope|targets|presets)\\s*(:)\\s*",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.yaml entity.name.tag.flow support.type.property-name.flow"
        },
        "2": {
          "name": "punctuation.separator.key-value.flow"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#variable-interpolation"
        },
        {
          "include": "#inline-arrays"
        },
        {
          "include": "#strings-quoted"
        },
        {
          "match": "[a-zA-Z0-9_.-]+",
          "name": "constant.language.enum.flow entity.name.type.enum.flow"
        }
      ]
    },
    "task-definitions": {
      "match": "^  ([a-zA-Z0-9_.-]+)\\s*(:)(?!\\s*[^\\s#])",
      "captures": {
        "1": {
          "name": "entity.name.function.task.flow"
        },
        "2": {
          "name": "punctuation.separator.key-value.flow"
        }
      }
    },
    "property-keys": {
      "match": "^\\s*(?:(-\\s+))?([a-zA-Z0-9_.-]+)\\s*(:)",
      "captures": {
        "1": {
          "name": "punctuation.definition.list.begin.flow"
        },
        "2": {
          "name": "entity.name.tag.yaml entity.name.tag.flow support.type.property-name.flow"
        },
        "3": {
          "name": "punctuation.separator.key-value.flow"
        }
      }
    },
    "inline-arrays": {
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.sequence.begin.flow"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.sequence.end.flow"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#variable-interpolation"
        },
        {
          "include": "#strings-quoted"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#constants"
        },
        {
          "match": "([a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+@[a-zA-Z0-9_.-]+)",
          "name": "support.class.action.flow entity.name.function.action.flow"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_.-]*\\b",
          "name": "constant.language.enum.flow entity.name.type.enum.flow"
        },
        {
          "match": "[a-zA-Z0-9_./-]+",
          "name": "string.unquoted.flow"
        },
        {
          "match": ",",
          "name": "punctuation.separator.sequence.flow"
        }
      ]
    },
    "list-item-values": {
      "match": "^\\s*(-\\s+)([^#\\r\\n]+)",
      "captures": {
        "1": {
          "name": "punctuation.definition.list.begin.flow"
        },
        "2": {
          "patterns": [
            {
              "include": "#variable-interpolation"
            },
            {
              "include": "#strings-quoted"
            },
            {
              "match": "([a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+@[a-zA-Z0-9_.-]+)",
              "name": "support.class.action.flow entity.name.function.action.flow"
            },
            {
              "match": "\\b[A-Z][a-zA-Z0-9_.-]*\\b",
              "name": "constant.language.enum.flow entity.name.type.enum.flow"
            },
            {
              "match": "[a-zA-Z0-9_./-]+/?",
              "name": "string.unquoted.path.flow"
            }
          ]
        }
      }
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false|yes|no|on|off)\\b",
          "name": "constant.language.boolean.flow"
        },
        {
          "match": "\\b(null|~)\\b",
          "name": "constant.language.null.flow"
        }
      ]
    },
    "numbers": {
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b",
      "name": "constant.numeric.flow"
    },
    "strings-quoted": {
      "patterns": [
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.flow"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.flow"
            }
          },
          "name": "string.quoted.double.flow",
          "patterns": [
            {
              "include": "#variable-interpolation"
            },
            {
              "match": "\\\\.",
              "name": "constant.character.escape.flow"
            }
          ]
        },
        {
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.flow"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.flow"
            }
          },
          "name": "string.quoted.single.flow",
          "patterns": [
            {
              "include": "#variable-interpolation"
            },
            {
              "match": "''",
              "name": "constant.character.escape.flow"
            }
          ]
        }
      ]
    }
  }
}
