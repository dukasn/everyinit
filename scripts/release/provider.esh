set -e

PROVIDER="${RELEASE_PROVIDER:-github}"
case "$PROVIDER" in
  github) PROVIDER_SCRIPT="scripts/release/providers/github.esh" ;;
  *)
    echo "Unsupported release provider '$PROVIDER'" >&2
    exit 2
    ;;
esac

if test "$1" = apply; then
  PLAN_PROVIDER="$(jq -er '.provider' "$2")"
  assert [ "$PLAN_PROVIDER" = "$PROVIDER" ] "Plan provider '$PLAN_PROVIDER' does not match selected release provider '$PROVIDER'"
fi

. "$PROVIDER_SCRIPT" "$@"
