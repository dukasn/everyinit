set -e

assert [ -z "$(git status --porcelain)" ] "release preparation requires a clean working tree"
BRANCH=$(git branch --show-current)
assert [ -n "$BRANCH" ] "release preparation requires a named topic branch"
assert [ "$BRANCH" != "main" ] "prepare releases from a topic branch based on release, then open a PR into release"
assert [ "$BRANCH" != "release" ] "prepare releases from a topic branch based on release, then open a PR into release"
git merge-base --is-ancestor release "$BRANCH"
assert [ -n "$(git config user.name)" ] "Git user.name is not configured"
assert [ -n "$(git config user.email)" ] "Git user.email is not configured"
