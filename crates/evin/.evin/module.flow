#!evin/v1
module:
  name: evin

tasks:
  build:
    stage: Build
    description: "Build the EVIN CLI crate"
    presets: [rust]
    steps:
      - run: cargo build -p evin --locked

  check:
    stage: Check
    description: "Check every EVIN CLI crate target"
    presets: [rust]
    steps:
      - run: cargo check -p evin --all-targets --locked

  lint:
    stage: Check
    description: "Run strict Clippy for every EVIN CLI target"
    presets: [rust]
    steps:
      - run: cargo clippy -p evin --all-targets --locked -- -D warnings

  test:
    stage: Test
    description: "Run EVIN CLI crate tests"
    presets: [rust]
    steps:
      - run: cargo test -p evin --locked

  e2e:
    stage: Test
    description: "Run EVIN binary-level integration tests"
    presets: [rust]
    steps:
      - run: cargo test -p evin --test cli_e2e --locked

  verify:
    stage: Test
    description: "Run all EVIN CLI maintenance checks"
    needs: [check, lint, test]
