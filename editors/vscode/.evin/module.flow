#!evin/v1
module:
  name: vscode
  include: [.evin/package.flow]

tasks:
  build:
    stage: Build
    description: "Bundle the Everyinit VS Code extension"
    steps:
      - run: npm run build

  check:
    stage: Check
    description: "Typecheck the Everyinit VS Code extension"
    steps:
      - run: npm run check

  lint:
    stage: Check
    description: "Lint the Everyinit VS Code extension source"
    steps:
      - run: npm run lint

  test:
    stage: Test
    description: "Run Everyinit VS Code extension unit tests"
    steps:
      - run: npm test

  e2e:
    stage: Test
    description: "Build the configured debug language servers and test the VS Code extension"
    needs: [evin:build, esh:build]
    presets: [node]
    steps:
      - run: npm run build:dev
      - run: npm run check
      - run: npm run lint
      - run: npm test

  verify:
    stage: Test
    description: "Verify Everyinit VS Code extension"
    needs: [check, lint, test, build]
