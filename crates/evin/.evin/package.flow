#!evin/v1
namespace:
  name: pkg
  description: "Evin binary packaging and distribution tasks"

tasks:
  stage:
    stage: Publish
    description: "Build, verify, and stage the EVIN release binary"
    cwd: .
    env: [RELEASE_TARGET, RELEASE_VERSION]
    needs: [release:rehearse-start]
    steps:
      - run: cargo build --release --locked --target "$RELEASE_TARGET" -p evin
      - run: cargo run --locked -p esh -- scripts/release/check/binary.esh evin "$RELEASE_TARGET" "$RELEASE_VERSION"
      - run: cargo run --locked -p esh -- scripts/release/package/stage.esh evin "$RELEASE_TARGET" "$RELEASE_VERSION" crates/evin/dist/staging

  cf:
    stage: Publish
    description: "Create Evin's Cloudflare tar.gz artifact"
    cwd: crates/evin/dist/staging
    env: [RELEASE_TARGET, RELEASE_VERSION]
    values:
      binary_name: evin
      artifact_dir: ../github
    needs: [stage]
    steps:
      - run: rm -f "../github/evin-v${RELEASE_VERSION}-"*.tar.gz
      - uses: evin/archive@v1
        with:
          path: "${artifact_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}.tar.gz"
          include: ["${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/**/*"]
          layout: relative
          compression_level: 9

  cf-verify:
    stage: Publish
    description: "Verify Evin's Cloudflare tar.gz artifact"
    cwd: .
    env: [RELEASE_TARGET, RELEASE_VERSION]
    needs: [cf]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/check/archive.esh evin "$RELEASE_TARGET" "$RELEASE_VERSION" crates/evin/dist/github

  native:
    stage: Publish
    description: "Create Evin's DEB, APK, and Arch package artifacts"
    cwd: .
    env: [RELEASE_TARGET, RELEASE_VERSION]
    values:
      binary_name: evin
      staging_dir: crates/evin/dist/staging
      package_output_dir: crates/evin/dist/packages
      package_summary: Evin workflow engine
      package_maintainer: Everyinit contributors
      package_license: GPL-3.0-only
      package_homepage: https://everyinit.dev
      binary_destination: /usr/bin
      license_source: LICENSE
      license_strip_prefix: .
      license_dir: /usr/share/licenses/evin
      notices_source: THIRD_PARTY_NOTICES.md
      notices_strip_prefix: .
      notices_dir: /usr/share/doc/evin
      licenses_source: LICENSES/**/*
      licenses_strip_prefix: LICENSES
      licenses_dir: /usr/share/licenses/evin/LICENSES
    needs: [stage, release:pkg:state]
    steps:
      - run: rm -f "crates/evin/dist/packages/evin_${RELEASE_VERSION}-"*_amd64.deb "crates/evin/dist/packages/evin-${RELEASE_VERSION}-r"*.apk "crates/evin/dist/packages/evin-${RELEASE_VERSION}-"*-x86_64.pkg.tar.zst
      - uses: evin/archive@v1
        with:
          format: deb
          output_dir: ${package_output_dir}
          architecture: x86_64
          release: "${release:pkg:state.release}"
          package:
            name: ${binary_name}
            summary: ${package_summary}
            maintainer: ${package_maintainer}
            license: ${package_license}
            homepage: ${package_homepage}
            payload:
              - source: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin/${binary_name}"
                strip_prefix: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin"
                destination: ${binary_destination}
                mode: 493
              - source: ${license_source}
                strip_prefix: ${license_strip_prefix}
                destination: ${license_dir}
              - source: "${notices_source}"
                strip_prefix: ${notices_strip_prefix}
                destination: ${notices_dir}
              - source: "${licenses_source}"
                strip_prefix: ${licenses_strip_prefix}
                destination: ${licenses_dir}
            targets:
              deb: {}
      - uses: evin/archive@v1
        with:
          format: apk
          output_dir: ${package_output_dir}
          architecture: x86_64
          release: "${release:pkg:state.release}"
          package:
            name: ${binary_name}
            summary: ${package_summary}
            maintainer: ${package_maintainer}
            license: ${package_license}
            homepage: ${package_homepage}
            payload:
              - source: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin/${binary_name}"
                strip_prefix: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin"
                destination: ${binary_destination}
                mode: 493
              - source: ${license_source}
                strip_prefix: ${license_strip_prefix}
                destination: ${license_dir}
              - source: "${notices_source}"
                strip_prefix: ${notices_strip_prefix}
                destination: ${notices_dir}
              - source: "${licenses_source}"
                strip_prefix: ${licenses_strip_prefix}
                destination: ${licenses_dir}
            targets:
              apk: {}
      - uses: evin/archive@v1
        with:
          format: arch
          output_dir: ${package_output_dir}
          architecture: x86_64
          release: "${release:pkg:state.release}"
          package:
            name: ${binary_name}
            summary: ${package_summary}
            maintainer: ${package_maintainer}
            license: ${package_license}
            homepage: ${package_homepage}
            payload:
              - source: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin/${binary_name}"
                strip_prefix: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin"
                destination: ${binary_destination}
                mode: 493
              - source: ${license_source}
                strip_prefix: ${license_strip_prefix}
                destination: ${license_dir}
              - source: "${notices_source}"
                strip_prefix: ${notices_strip_prefix}
                destination: ${notices_dir}
              - source: "${licenses_source}"
                strip_prefix: ${licenses_strip_prefix}
                destination: ${licenses_dir}
            targets:
              arch: {}

  native-verify:
    stage: Publish
    description: "Verify Evin's DEB, APK, and Arch package artifacts"
    cwd: .
    env: [RELEASE_VERSION]
    needs: [native]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/check/native-artifacts.esh evin "$RELEASE_VERSION" crates/evin/dist/packages

  gh:
    stage: Publish
    description: "Create every Evin artifact format for GitHub Releases"
    needs: [cf, native]

  gh-verify:
    stage: Publish
    description: "Verify every Evin artifact format for GitHub Releases"
    needs: [gh, cf-verify, native-verify]

  verify:
    stage: Publish
    description: "Verify all Evin release package formats"
    needs: [gh-verify]

  dist-verify:
    stage: Publish
    description: "Build and verify evin's complete distribution set for rehearsal"
    cwd: .
    env: [RELEASE_TARGET, RELEASE_VERSION]
    needs: [verify]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/check/distribution.esh evin "$RELEASE_VERSION" "$RELEASE_TARGET" crates/evin/dist
