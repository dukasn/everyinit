#!evin/v1
namespace:
  name: package
  description: "Esh binary packaging and distribution tasks"

tasks:
  stage:
    stage: Publish
    description: "Build, verify, and stage the ESH release binary"
    cwd: .
    env: [RELEASE_TARGET, RELEASE_VERSION]
    needs: [release:rehearsal-start]
    steps:
      - run: cargo build --release --locked --target "$RELEASE_TARGET" -p esh
      - run: cargo run --locked -p esh -- scripts/release/check/binary.esh esh "$RELEASE_TARGET" "$RELEASE_VERSION"
      - run: cargo run --locked -p esh -- scripts/release/package/stage.esh esh "$RELEASE_TARGET" "$RELEASE_VERSION" crates/esh/dist/staging

  cloudflare:
    stage: Publish
    description: "Create ESH's Cloudflare tar.gz artifact"
    cwd: crates/esh/dist/staging
    env: [RELEASE_TARGET, RELEASE_VERSION]
    values:
      binary_name: esh
      artifact_dir: ../github
    needs: [stage]
    steps:
      - run: rm -f "../github/esh-v${RELEASE_VERSION}-"*.tar.gz
      - uses: evin/archive@v1
        with:
          path: "${artifact_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}.tar.gz"
          include: ["${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/**/*"]
          layout: relative
          compression_level: 9

  cloudflare-verify:
    stage: Publish
    description: "Verify ESH's Cloudflare tar.gz artifact"
    cwd: .
    env: [RELEASE_TARGET, RELEASE_VERSION]
    needs: [cloudflare]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/check/archive.esh esh "$RELEASE_TARGET" "$RELEASE_VERSION" crates/esh/dist/github

  native:
    stage: Publish
    description: "Create ESH's DEB, APK, and Arch package artifacts"
    cwd: .
    env: [RELEASE_TARGET, RELEASE_VERSION]
    values:
      binary_name: esh
      staging_dir: crates/esh/dist/staging
      package_output_dir: crates/esh/dist/packages
      package_summary: ESH portable shell runtime
      package_maintainer: Everyinit contributors
      package_license: GPL-3.0-only
      package_homepage: https://everyinit.dev
      binary_destination: /usr/bin
      license_source: LICENSE
      license_strip_prefix: .
      license_dir: /usr/share/licenses/esh
      notices_source: THIRD_PARTY_NOTICES.md
      notices_strip_prefix: .
      notices_dir: /usr/share/doc/esh
      licenses_source: LICENSES/**/*
      licenses_strip_prefix: LICENSES
      licenses_dir: /usr/share/licenses/esh/LICENSES
    needs: [stage, release:package-state]
    steps:
      - run: rm -f "crates/esh/dist/packages/esh_${RELEASE_VERSION}-"*_amd64.deb "crates/esh/dist/packages/esh-${RELEASE_VERSION}-r"*.apk "crates/esh/dist/packages/esh-${RELEASE_VERSION}-"*-x86_64.pkg.tar.zst
      - uses: evin/archive@v1
        with:
          format: deb
          output_dir: ${package_output_dir}
          architecture: x86_64
          release: "${release:package-state.release}"
          package:
            name: ${binary_name}
            summary: ${package_summary}
            maintainer: ${package_maintainer}
            license: ${package_license}
            homepage: ${package_homepage}
            payload:
              - source: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin/${binary_name}"
                strip_prefix: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin"
                destination: ${binary_destination}
                mode: 493
              - source: ${license_source}
                strip_prefix: ${license_strip_prefix}
                destination: ${license_dir}
              - source: "${notices_source}"
                strip_prefix: ${notices_strip_prefix}
                destination: ${notices_dir}
              - source: "${licenses_source}"
                strip_prefix: ${licenses_strip_prefix}
                destination: ${licenses_dir}
            targets:
              deb: {}
      - uses: evin/archive@v1
        with:
          format: apk
          output_dir: ${package_output_dir}
          architecture: x86_64
          release: "${release:package-state.release}"
          package:
            name: ${binary_name}
            summary: ${package_summary}
            maintainer: ${package_maintainer}
            license: ${package_license}
            homepage: ${package_homepage}
            payload:
              - source: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin/${binary_name}"
                strip_prefix: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin"
                destination: ${binary_destination}
                mode: 493
              - source: ${license_source}
                strip_prefix: ${license_strip_prefix}
                destination: ${license_dir}
              - source: "${notices_source}"
                strip_prefix: ${notices_strip_prefix}
                destination: ${notices_dir}
              - source: "${licenses_source}"
                strip_prefix: ${licenses_strip_prefix}
                destination: ${licenses_dir}
            targets:
              apk: {}
      - uses: evin/archive@v1
        with:
          format: arch
          output_dir: ${package_output_dir}
          architecture: x86_64
          release: "${release:package-state.release}"
          package:
            name: ${binary_name}
            summary: ${package_summary}
            maintainer: ${package_maintainer}
            license: ${package_license}
            homepage: ${package_homepage}
            payload:
              - source: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin/${binary_name}"
                strip_prefix: "${staging_dir}/${binary_name}-v${env.RELEASE_VERSION}-${env.RELEASE_TARGET}/bin"
                destination: ${binary_destination}
                mode: 493
              - source: ${license_source}
                strip_prefix: ${license_strip_prefix}
                destination: ${license_dir}
              - source: "${notices_source}"
                strip_prefix: ${notices_strip_prefix}
                destination: ${notices_dir}
              - source: "${licenses_source}"
                strip_prefix: ${licenses_strip_prefix}
                destination: ${licenses_dir}
            targets:
              arch: {}

  native-verify:
    stage: Publish
    description: "Verify ESH's DEB, APK, and Arch package artifacts"
    cwd: .
    env: [RELEASE_VERSION]
    needs: [native]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/check/native-artifacts.esh esh "$RELEASE_VERSION" crates/esh/dist/packages

  github:
    stage: Publish
    description: "Create every ESH artifact format for GitHub Releases"
    needs: [cloudflare, native]

  github-verify:
    stage: Publish
    description: "Verify every ESH artifact format for GitHub Releases"
    needs: [github, cloudflare-verify, native-verify]

  verify:
    stage: Publish
    description: "Verify all ESH release package formats"
    needs: [github-verify]

  distribution-verify:
    stage: Publish
    description: "Build and verify esh's complete distribution set for rehearsal"
    cwd: .
    env: [RELEASE_TARGET, RELEASE_VERSION]
    needs: [verify]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/check/distribution.esh esh "$RELEASE_VERSION" "$RELEASE_TARGET" crates/esh/dist
