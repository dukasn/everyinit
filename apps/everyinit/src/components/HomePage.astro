---
import SiteLayout from "../layouts/SiteLayout.astro";
import { availableLocales, createTranslator } from "../i18n";
import HomeNavigation from "./HomeNavigation.astro";
import HomeHero from "./HomeHero.astro";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const t = createTranslator(locale);
const canonical = `https://everyinit.dev${locale === "en" ? "/" : `/${locale}/`}`;
const alternates = availableLocales.map((language) => ({
  locale: language,
  href: `https://everyinit.dev${language === "en" ? "/" : `/${language}/`}`,
}));
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Everyinit",
    url: "https://everyinit.dev/",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Everyinit",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux",
    license: "https://spdx.org/licenses/GPL-3.0-only.html",
    codeRepository: "https://github.com/dukasn/everyinit",
    sameAs: [
      "https://github.com/dukasn/everyinit",
      "https://www.npmjs.com/package/everyinit",
      "https://marketplace.visualstudio.com/items?itemName=everyinit.everyinit",
    ],
  },
];

const contracts = [
  {
    number: "01",
    kind: t("home-contract-one-kind"),
    file: t("home-contract-one-file"),
    title: t("home-contract-one-title"),
    text: t("home-contract-one-description"),
  },
  {
    number: "02",
    kind: t("home-contract-two-kind"),
    file: t("home-contract-two-file"),
    title: t("home-contract-two-title"),
    text: t("home-contract-two-description"),
  },
  {
    number: "03",
    kind: t("home-contract-three-kind"),
    file: t("home-contract-three-file"),
    title: t("home-contract-three-title"),
    text: t("home-contract-three-description"),
  },
];

const trustPillars = [
  {
    label: t("home-trust-one-label"),
    title: t("home-trust-one-title"),
    text: t("home-trust-one-description"),
  },
  {
    label: t("home-trust-two-label"),
    title: t("home-trust-two-title"),
    text: t("home-trust-two-description"),
  },
  {
    label: t("home-trust-three-label"),
    title: t("home-trust-three-title"),
    text: t("home-trust-three-description"),
  },
  {
    label: t("home-trust-four-label"),
    title: t("home-trust-four-title"),
    text: t("home-trust-four-description"),
  },
];

const integrations = [
  t("home-integrations-terminal"),
  t("home-integrations-git-hooks"),
  t("home-integrations-ide"),
  t("home-integrations-ci"),
  t("home-integrations-actions"),
];

const projects = [
  {
    number: "02",
    name: "ESH",
    label: t("home-project-esh-label"),
    description: t("home-project-esh-description"),
    href: "/docs/book/esh/",
    link: t("home-project-esh-link"),
  },
  {
    number: "03",
    name: t("home-project-ide-name"),
    label: t("home-project-ide-label"),
    description: t("home-project-ide-description"),
    href: "/docs/book/esh/editor-integration/",
    link: t("home-project-ide-link"),
  },
  {
    number: "04",
    name: t("home-project-web-name"),
    label: t("home-project-web-label"),
    description: t("home-project-web-description"),
    href: "https://www.npmjs.com/package/everyinit",
    link: t("home-project-web-link"),
  },
];
---

<SiteLayout
  locale={locale}
  title={t("site-canonical-title")}
  description={t("site-canonical-description")}
  canonical={canonical}
  alternates={alternates}
  xDefault="https://everyinit.dev/"
  structuredData={structuredData}
>
  <HomeNavigation locale={locale} />

  <main>
    <HomeHero locale={locale} />

    <section
      id="integrations"
      class="border-y border-line bg-[color-mix(in_srgb,var(--color-lime)_5%,var(--color-paper))]"
    >
      <div
        class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-7 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:px-12"
      >
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--accent-strong)]">
          {t("home-integrations-eyebrow")}
        </p>
        <div class="flex flex-wrap gap-x-7 gap-y-3 text-sm text-moss">
          {
            integrations.map((integration) => (
              <span class="inline-flex items-center gap-2.5">
                <span class="size-2 rounded-full bg-[var(--accent-strong)]" />
                {integration}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <section id="workflow" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
        <div class="max-w-md">
          <p class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--accent-strong)]">
            {t("home-workflow-eyebrow")}
          </p>
          <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-[-.055em] sm:text-5xl">
            {t("home-workflow-title")}
          </h2>
          <p class="mt-6 text-base leading-7 text-moss">{t("home-workflow-description")}</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a
              href="/docs/book/concepts/why-everyinit/"
              class="inline-flex items-center gap-2 text-sm font-semibold text-ink underline decoration-[color-mix(in_srgb,var(--accent-strong)_45%,transparent)] underline-offset-4 transition hover:text-[var(--accent-strong)]"
            >
              {t("home-workflow-link")} <span aria-hidden="true">↗</span>
            </a>
            <a
              href="/docs/book/concepts/why-everyinit/#compared-with-other-tools"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-moss underline decoration-line underline-offset-4 transition hover:text-ink"
            >
              {t("home-workflow-compare-link")} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {
            contracts.map((item) => (
              <article class="rounded-2xl border border-line bg-[linear-gradient(155deg,color-mix(in_srgb,var(--color-lime)_8%,var(--color-surface))_0%,var(--color-surface)_65%)] p-6 transition-colors hover:border-[color-mix(in_srgb,var(--accent-strong)_34%,var(--color-line))] sm:p-7">
                <p class="font-mono text-xs text-moss">
                  <span class="font-semibold text-[var(--accent-strong)]">{item.number}</span> /{" "}
                  {item.kind}
                </p>
                <p class="mt-4 font-mono text-xs font-medium text-[var(--accent-strong)]">
                  {item.file}
                </p>
                <h3 class="mt-2 text-xl font-semibold tracking-tight">{item.title}</h3>
                <p class="mt-3 text-sm leading-6 text-moss">{item.text}</p>
              </article>
            ))
          }
          <a
            href="/docs/book/esh/"
            class="group flex flex-col justify-between rounded-2xl border border-[color-mix(in_srgb,var(--accent-strong)_26%,var(--color-line))] bg-[linear-gradient(135deg,color-mix(in_srgb,var(--color-lime)_32%,var(--color-surface))_0%,color-mix(in_srgb,var(--color-lime)_14%,var(--color-paper))_100%)] p-6 transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:border-[color-mix(in_srgb,var(--accent-strong)_48%,var(--color-line))] hover:shadow-[0_16px_36px_-28px_rgba(23,33,26,.5)] sm:p-7"
          >
            <p class="font-mono text-xs font-medium text-[var(--accent-strong)]">
              {t("home-contract-four-label")}
            </p>
            <div class="mt-8 flex items-end justify-between gap-4">
              <p class="max-w-[15rem] text-xl font-semibold leading-snug tracking-tight text-ink">
                {t("home-contract-four-copy")}
              </p>
              <span
                class="grid size-11 shrink-0 place-items-center rounded-full bg-ink text-xl text-lime transition-transform duration-200 group-hover:scale-105"
                aria-hidden="true">↗</span
              >
            </div>
          </a>
        </div>
      </div>
    </section>

    <section
      id="trust"
      aria-labelledby="trust-heading"
      class="border-y border-line bg-[color-mix(in_srgb,var(--color-lime)_5%,var(--color-paper))]"
    >
      <div
        class="mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-8 sm:py-24 lg:grid-cols-[.82fr_1.18fr] lg:items-start lg:px-12 lg:py-28"
      >
        <div class="max-w-md">
          <p class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--accent-strong)]">
            {t("home-trust-eyebrow")}
          </p>
          <h2
            id="trust-heading"
            class="mt-5 text-4xl font-semibold leading-tight tracking-[-.055em] text-ink sm:text-5xl"
          >
            {t("home-trust-title")}
          </h2>
          <p class="mt-6 text-base leading-7 text-moss">{t("home-trust-description")}</p>
          <p
            class="mt-6 rounded-xl border border-[color-mix(in_srgb,var(--accent-strong)_26%,var(--color-line))] bg-[linear-gradient(135deg,color-mix(in_srgb,var(--color-lime)_24%,var(--color-paper))_0%,color-mix(in_srgb,var(--color-lime)_8%,var(--color-surface))_100%)] px-4 py-3.5 font-mono text-xs leading-5 text-ink"
          >
            {t("home-trust-disclaimer")}
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a
              href="/docs/book/concepts/execution-and-trust-model/"
              class="group inline-flex items-center gap-2 text-sm font-semibold text-ink underline decoration-[color-mix(in_srgb,var(--accent-strong)_45%,transparent)] underline-offset-4 transition hover:text-[var(--accent-strong)]"
            >
              {t("home-trust-cta")}
              <span
                class="motion-safe:transition-transform motion-safe:duration-200 group-hover:translate-x-0.5"
                aria-hidden="true">↗</span
              >
            </a>
            <a
              href="/docs/book/installation/#verify-a-release"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-moss underline decoration-line underline-offset-4 transition hover:text-ink"
            >
              {t("home-trust-verify")} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
          {
            trustPillars.map((pillar) => (
              <article class="bg-[linear-gradient(160deg,color-mix(in_srgb,var(--color-lime)_9%,var(--color-surface))_0%,var(--color-surface)_55%)] p-6 sm:p-7">
                <p class="font-mono text-[10px] font-semibold uppercase tracking-[.14em] text-[var(--accent-strong)]">
                  {pillar.label}
                </p>
                <h3 class="mt-5 text-lg font-semibold tracking-tight text-ink">{pillar.title}</h3>
                <p class="mt-2.5 text-sm leading-6 text-moss">{pillar.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="projects" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28">
      <div class="mb-10 grid gap-6 sm:mb-12 lg:grid-cols-[1fr_auto] lg:items-end">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--accent-strong)]">
            {t("home-ecosystem-eyebrow")}
          </p>
          <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-[-.055em] sm:text-5xl">
            {t("home-ecosystem-title")}
          </h2>
        </div>
        <p class="max-w-md text-sm leading-6 text-moss">{t("home-ecosystem-description")}</p>
      </div>

      <div
        class="grid overflow-hidden rounded-[1.75rem] border border-line bg-surface lg:grid-cols-[.78fr_1.22fr]"
      >
        <article class="relative flex flex-col justify-between gap-10 bg-ink p-7 text-paper sm:p-10">
          <div>
            <p class="font-mono text-xs uppercase tracking-[.14em] text-[#bac8b0]">
              <span class="text-lime">01</span> <span class="px-1 text-[#71806e]">/</span>{" "}
              {t("home-ecosystem-core-label")}
            </p>
            <h3 class="mt-8 text-4xl font-semibold tracking-[-.05em] sm:text-5xl">Evin</h3>
            <p class="mt-4 max-w-sm text-sm leading-6 text-[#c0c9bc]">
              {t("home-ecosystem-evin-description")}
            </p>
          </div>
          <a
            href="/docs/book/first-workflow/"
            class="group inline-flex w-fit items-center gap-2 text-sm font-semibold text-lime underline decoration-lime/45 underline-offset-4 hover:text-white"
          >
            {t("home-ecosystem-first-workflow")}
            <span
              class="motion-safe:transition-transform motion-safe:duration-200 group-hover:translate-x-1"
              aria-hidden="true">↗</span
            >
          </a>
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -right-5 top-1/2 hidden size-10 -translate-y-1/2 items-center justify-center rounded-full border-[6px] border-surface bg-lime text-lg text-ink lg:flex"
            >›</span
          >
        </article>

        <div class="divide-y divide-line">
          {
            projects.map((project) => (
              <a
                href={project.href}
                aria-label={`${project.link} — ${project.name}`}
                class="group grid gap-3 px-6 py-6 transition-colors hover:bg-[linear-gradient(90deg,color-mix(in_srgb,var(--color-lime)_15%,var(--color-surface))_0%,var(--color-surface)_100%)] sm:grid-cols-[3.5rem_1fr_auto] sm:items-center sm:gap-5 sm:px-10 sm:py-7"
              >
                <span class="font-mono text-xs font-semibold text-[var(--accent-strong)]">
                  {project.number}
                </span>
                <div>
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <h3 class="text-lg font-semibold tracking-tight text-ink">{project.name}</h3>
                    <span class="text-[9px] font-semibold uppercase tracking-[.13em] text-moss">
                      {project.label}
                    </span>
                  </div>
                  <p class="mt-1.5 max-w-xl text-sm leading-6 text-moss">{project.description}</p>
                </div>
                <span class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-ink underline decoration-[color-mix(in_srgb,var(--accent-strong)_45%,transparent)] underline-offset-4 group-hover:text-[var(--accent-strong)] sm:justify-self-end">
                  <span class="sm:hidden">{project.link}</span>
                  <span
                    class="motion-safe:transition-transform motion-safe:duration-200 group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 pb-20 sm:px-8 sm:pb-24 lg:px-12 lg:pb-28">
      <div class="overflow-hidden rounded-[2rem] bg-ink text-paper">
        <div class="grid gap-10 p-7 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-end lg:p-14">
          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-[.16em] text-lime/85">
              {t("home-install-eyebrow")}
            </p>
            <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-[-.055em] sm:text-5xl">
              {t("home-install-title")}
            </h2>
            <p class="mt-5 max-w-xl leading-7 text-[#b5c0b1]">{t("home-install-description")}</p>
            <a
              href="/docs/book/installation/#verify-a-release"
              class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-lime underline decoration-lime/45 underline-offset-4 hover:text-white"
            >
              {t("home-install-verify")} <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <a
              href="/docs/book/installation/"
              class="group inline-flex items-center justify-center gap-3 rounded-full bg-lime px-6 py-4 text-sm font-semibold text-ink transition hover:brightness-105 active:scale-[.98]"
              >{t("home-install-button")}
              <span
                class="motion-safe:transition-transform motion-safe:duration-200 group-hover:translate-x-1"
                aria-hidden="true">↗</span
              ></a
            >
            <a
              href="https://github.com/dukasn/everyinit/releases"
              class="inline-flex items-center justify-center gap-3 rounded-full border border-white/20 px-6 py-4 text-sm font-semibold text-paper transition hover:bg-white/10"
              >{t("home-install-releases")} <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>
        <div
          class="grid divide-y divide-white/10 border-t border-white/10 text-sm sm:grid-cols-3 sm:divide-x sm:divide-y-0"
        >
          <a
            href="https://github.com/dukasn/everyinit/releases/latest"
            class="flex items-center justify-between gap-3 px-7 py-5 text-[#e0e8dc] transition hover:bg-white/5 sm:px-8"
          >
            <span>{t("home-install-linux")}</span><span
              class="font-mono text-[10px] uppercase tracking-wide text-lime/85"
              >{t("home-install-downloads")}</span
            >
          </a>
          <div class="flex items-center justify-between gap-3 px-7 py-5 text-[#bbc6b7] sm:px-8">
            <span>{t("home-install-macos")}</span><span
              class="font-mono text-[10px] uppercase tracking-wide text-[#819080]"
              >{t("home-install-unavailable")}</span
            >
          </div>
          <div class="flex items-center justify-between gap-3 px-7 py-5 text-[#bbc6b7] sm:px-8">
            <span>{t("home-install-windows")}</span><span
              class="font-mono text-[10px] uppercase tracking-wide text-[#819080]"
              >{t("home-install-unavailable")}</span
            >
          </div>
        </div>
      </div>
    </section>

    <section
      aria-labelledby="support-heading"
      class="border-y border-line bg-[color-mix(in_srgb,var(--color-lime)_5%,var(--color-paper))]"
    >
      <div
        class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:gap-16 lg:px-12 lg:py-24"
      >
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[.16em] text-[var(--accent-strong)]">
            {t("home-support-eyebrow")}
          </p>
          <h2
            id="support-heading"
            class="mt-5 max-w-[15ch] text-4xl font-semibold leading-[1.05] tracking-[-.055em] text-ink sm:text-5xl"
          >
            {t("home-support-title")}
          </h2>
          <p class="mt-5 max-w-xl text-base leading-7 text-[#637063] sm:text-lg sm:leading-8">
            {t("home-support-description")}
          </p>
          <ul class="mt-6 space-y-2.5 text-sm leading-6 text-moss">
            <li class="flex items-start gap-3">
              <span class="mt-2 size-2 shrink-0 rounded-full bg-[var(--accent-strong)]"></span>
              <span>{t("home-support-way-discuss")}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-2 size-2 shrink-0 rounded-full bg-[var(--accent-strong)]"></span>
              <span>{t("home-support-way-contribute")}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-2 size-2 shrink-0 rounded-full bg-[var(--accent-strong)]"></span>
              <span>{t("home-support-way-feedback")}</span>
            </li>
          </ul>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a
              href="/docs/contributing/opportunities/"
              class="group inline-flex items-center gap-2 text-sm font-semibold text-ink underline decoration-[color-mix(in_srgb,var(--accent-strong)_45%,transparent)] underline-offset-4 transition hover:text-[var(--accent-strong)]"
            >
              {t("home-support-opportunities")}
              <span
                class="motion-safe:transition-transform motion-safe:duration-200 group-hover:translate-x-1"
                aria-hidden="true">↗</span
              >
            </a>
            <a
              href="https://github.com/dukasn/everyinit/issues"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-moss underline decoration-line underline-offset-4 transition hover:text-ink"
            >
              {t("home-support-github")} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
          <div class="bg-surface p-6 sm:p-7">
            <p class="font-mono text-[10px] font-semibold uppercase tracking-[.14em] text-[var(--accent-strong)]">
              {t("home-support-costs")}
            </p>
            <ul class="mt-5 space-y-3 text-sm text-[#536052]">
              <li class="flex items-center gap-3">
                <span class="size-2 rounded-full bg-[var(--accent-strong)]"></span>{
                  t("home-support-hosting")
                }
              </li>
              <li class="flex items-center gap-3">
                <span class="size-2 rounded-full bg-[var(--accent-strong)]"></span>{
                  t("home-support-infrastructure")
                }
              </li>
              <li class="flex items-center gap-3">
                <span class="size-2 rounded-full bg-[var(--accent-strong)]"></span>{
                  t("home-support-development")
                }
              </li>
            </ul>
          </div>
          <div
            class="flex flex-col justify-between gap-7 bg-[linear-gradient(145deg,color-mix(in_srgb,var(--color-lime)_26%,var(--color-surface))_0%,color-mix(in_srgb,var(--color-lime)_10%,var(--color-paper))_100%)] p-6 sm:p-7"
          >
            <div>
              <p class="font-mono text-[10px] font-semibold uppercase tracking-[.14em] text-[var(--accent-strong)]">
                {t("home-support-maintainer")}
              </p>
              <p class="mt-4 text-lg font-semibold tracking-tight text-ink">dukasn</p>
              <p class="mt-1 text-sm text-[#637063]">{t("home-support-maintainer-description")}</p>
            </div>
            <a
              href="https://github.com/dukasn"
              class="group inline-flex w-fit items-center gap-2 text-sm font-semibold text-ink underline decoration-[color-mix(in_srgb,var(--accent-strong)_45%,transparent)] underline-offset-4 transition hover:text-[var(--accent-strong)]"
            >
              {t("home-support-profile")}
              <span
                class="motion-safe:transition-transform motion-safe:duration-200 group-hover:translate-x-1"
                aria-hidden="true">↗</span
              >
            </a>
