#!evin/v1
namespace:
  name: deploy
  description: "Deploy the Everyinit Pages site and public Cloudflare Workers"

tasks:
  site:
    stage: Publish
    description: "Deploy the verified Everyinit site to a Cloudflare Pages branch"
    cwd: .
    env: [CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, SITE_BRANCH]
    needs: [site:verify]
    steps:
      - run: cd apps/everyinit && corepack npm exec -- wrangler pages deploy dist --project-name everyinit-site --branch "$SITE_BRANCH"

  installer:
    stage: Publish
    description: "Deploy the get.everyinit.dev installer Worker"
    cwd: .
    needs: [infra:verify]
    steps:
      - run: corepack npm exec -- wrangler deploy --config infra/get/wrangler.toml

  mirror:
    stage: Publish
    description: "Deploy the dl.everyinit.dev R2 mirror Worker"
    cwd: .
    needs: [infra:verify]
    steps:
      - run: corepack npm exec -- wrangler deploy --config infra/mirror/wrangler.toml

  workers:
    stage: Publish
    description: "Verify and deploy both public Cloudflare Workers"
    cwd: .
    needs:
      - infra:deploy:installer
      - infra:deploy:mirror
