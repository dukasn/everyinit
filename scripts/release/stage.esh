set -e

assert [ "$#" -eq 2 ] "usage: stage.esh <target-triple> <version>"

TARGET="$1"
VERSION="$2"

assert [ "$TARGET" = "x86_64-unknown-linux-musl" ] "unsupported release target: $TARGET"
assert [ -n "$VERSION" ] "release version must not be empty"
assert [ "$(basename "$VERSION")" = "$VERSION" ] "release version must be one path component"

EVIN_BIN="target/$TARGET/release/evin"
ESH_BIN="target/$TARGET/release/esh"
RELEASE_DIR="dist/release-stage/evin-v$VERSION-$TARGET"

assert [ -x "$EVIN_BIN" ] "missing executable EVIN binary: $EVIN_BIN"
assert [ -x "$ESH_BIN" ] "missing executable ESH binary: $ESH_BIN"
assert [ -f LICENSE ] "missing LICENSE"
assert [ -d THIRD_PARTY_NOTICES ] "missing THIRD_PARTY_NOTICES directory"

rm -rf "$RELEASE_DIR"
mkdir -p "$RELEASE_DIR"
cp "$EVIN_BIN" "$RELEASE_DIR/evin"
cp "$ESH_BIN" "$RELEASE_DIR/esh"
cp LICENSE "$RELEASE_DIR/LICENSE"
cp -r THIRD_PARTY_NOTICES "$RELEASE_DIR/THIRD_PARTY_NOTICES"

echo "Staged release bundle at $RELEASE_DIR"
