---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  locale?: string;
}

const {
  title = "Everyinit — development, orchestrated",
  description = "A calmer way to run the work around your code.",
  canonical = "https://everyinit.dev/",
  locale = "en",
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f3ec" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Everyinit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
