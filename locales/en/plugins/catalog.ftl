# Documentation catalog action messages

catalog-invalid-config = Invalid catalog configuration: { $error }
catalog-json-serialization-failed = Failed to serialize catalog: { $error }
catalog-output-write-failed = Failed to write catalog: { $error }
catalog-source-read-failed = Failed to read { $path }: { $error }
catalog-reference-prefix-invalid = reference_prefix must contain only ASCII letters and digits
catalog-output-invalid = Generated catalog is invalid: { $error }
catalog-source-navigation-order-invalid = Documentation source '{ $path }' has an invalid navigation order
catalog-source-formal-reference-invalid = Invalid formal reference in documentation source: { $error }
catalog-source-compilation-failed = Failed to compile documentation source '{ $path }': { $error }

catalog-invalid-config-title = Invalid Catalog Configuration
catalog-json-serialization-failed-title = Catalog Serialization Failed
catalog-output-write-failed-title = Catalog Write Failed
catalog-source-read-failed-title = Catalog Source Read Failed
catalog-reference-prefix-invalid-title = Invalid Catalog Configuration
catalog-output-invalid-title = Invalid Generated Catalog
catalog-source-navigation-order-invalid-title = Invalid Documentation Source
catalog-source-formal-reference-invalid-title = Invalid Formal Reference
catalog-source-compilation-failed-title = Documentation Compilation Failed
