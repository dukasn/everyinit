set -e

assert [ "$#" -eq 3 ] "usage: binary.esh <evin|esh> <target-triple> <version>"
PACKAGE="$1"
TARGET="$2"
VERSION="$3"
case "$PACKAGE" in
  evin|esh)
    ;;
  *)
    echo "unsupported release binary: $PACKAGE" >&2
    exit 1
    ;;
esac
assert [ "$TARGET" = "x86_64-unknown-linux-musl" ] "unsupported release target: $TARGET"
assert [ -n "$VERSION" ] "release version must not be empty"
BIN="target/$TARGET/release/$PACKAGE"

assert [ -x "$BIN" ] "missing executable release binary: $BIN"
assert "! readelf -l $BIN | grep -Fq 'Requesting program interpreter'" -- "$PACKAGE binary must be statically linked"
assert "$BIN --version | grep -Fq '$VERSION'" -- "$PACKAGE binary version does not match $VERSION"
