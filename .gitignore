# Ignore everything in the root
/*

# Explicitly allow standard root files and directories
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/.node-version
# Public repository entry point; the root deny-all rule otherwise excludes it.
!/README.md
!/CI.md
!/BANNER.webp
!/docs/
!/crates/
!/.cargo/
!/.evin/
!/.github/
!/builtins/
!/infra/
!/locales/
!/CHANGELOG.md
!/LICENSE
!/LICENSES/
!/ACKNOWLEDGMENTS.md
!/THIRD_PARTY_NOTICES.md
!/TRADEMARKS.md
!/CONTRIBUTING.md
!/DCO.txt
!/REUSE.toml
!/package.json
!/package-lock.json
!/playwright.config.mjs
!/scripts/
!/tests/

# (progress.md and STACK.md remain excluded by the /* rule)

# Standard Rust & editor ignores for allowed directories
target/
node_modules/
**/dist/
**/staging/
__pycache__/
*.pyc
**/*.rs.bk
**/*.log
**/*.tmp
**/*.bak
**/*~
**/*.swp
**/.DS_Store
**/.wrangler/
**/.evin/trace.json
**/.evin/build/
/.evin/actions/ci/
