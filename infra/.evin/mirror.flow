#!evin/v1
namespace:
  name: mirror
  description: "Prepare and publish signed artifacts to the Cloudflare R2 mirror"

tasks:
  metadata:
    stage: Publish
    description: "Build and sign both local mirror release manifests"
    cwd: .
    env: [RELEASE_CHANNEL, RELEASE_COMMIT, RELEASE_BASE_URL, RELEASE_TARGET, RELEASE_VERSION, RELEASE_SIGNING_KEY_FILE]
    needs:
      - evin:package:cloudflare-verify
      - esh:package:cloudflare-verify
    steps:
      - run: cargo run --locked -p esh -- scripts/release/mirror/metadata.esh evin "$RELEASE_CHANNEL" "$RELEASE_VERSION" "$RELEASE_TARGET" dist/mirror crates/evin/dist/github
      - run: cargo run --locked -p esh -- scripts/release/mirror/metadata.esh esh "$RELEASE_CHANNEL" "$RELEASE_VERSION" "$RELEASE_TARGET" dist/mirror crates/esh/dist/github
      - run: cargo run --locked -p esh -- scripts/release/mirror/channel-manifest.esh "$RELEASE_CHANNEL" "$RELEASE_VERSION" "$RELEASE_TARGET" dist/mirror

  metadata-prebuilt:
    stage: Publish
    description: "Sign mirror metadata from verified artifacts downloaded from the build job"
    cwd: .
    env: [RELEASE_CHANNEL, RELEASE_COMMIT, RELEASE_BASE_URL, RELEASE_TARGET, RELEASE_VERSION, RELEASE_SIGNING_KEY_FILE]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/mirror/metadata.esh evin "$RELEASE_CHANNEL" "$RELEASE_VERSION" "$RELEASE_TARGET" dist/mirror crates/evin/dist/github
      - run: cargo run --locked -p esh -- scripts/release/mirror/metadata.esh esh "$RELEASE_CHANNEL" "$RELEASE_VERSION" "$RELEASE_TARGET" dist/mirror crates/esh/dist/github
      - run: cargo run --locked -p esh -- scripts/release/mirror/channel-manifest.esh "$RELEASE_CHANNEL" "$RELEASE_VERSION" "$RELEASE_TARGET" dist/mirror

  publish-objects:
    stage: Publish
    description: "Publish verified immutable archives and metadata without moving channel pointers"
    cwd: .
    env: [CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, RELEASE_CHANNEL, RELEASE_VERSION]
    needs: [infra:mirror:metadata-prebuilt]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/mirror/publish.esh "$RELEASE_CHANNEL" "$RELEASE_VERSION" objects dist/mirror

  publish-pointers:
    stage: Publish
    description: "Move the shared channel pointer after GitHub and mirror objects are ready"
    cwd: .
    env: [CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, RELEASE_CHANNEL, RELEASE_VERSION]
    needs: [release:github-publish-prebuilt]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/mirror/publish.esh "$RELEASE_CHANNEL" "$RELEASE_VERSION" pointers dist/mirror

  seed:
    stage: Publish
    description: "Seed generated channel objects into Wrangler's local R2 storage"
    cwd: .
    needs: [infra:mirror:metadata]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/mirror/seed-local.esh dist/mirror

  publish:
    stage: Publish
    description: "Publish both binaries and move the channel pointer last"
    cwd: .
    env: [CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, RELEASE_CHANNEL, RELEASE_VERSION]
    steps:
      - run: cargo run --locked -p esh -- scripts/release/mirror/publish.esh "$RELEASE_CHANNEL" "$RELEASE_VERSION" all dist/mirror
