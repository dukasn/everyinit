#!evin/v1
module:
  name: docs

tasks:
  evin-catalog:
    stage: Docs
    description: "Generate the tracked Evin configuration catalog intentionally"
    needs: [main:build]
    steps:
      - uses: evin/catalog@v1
        with:
          source_dir: docs/reference
          include:
            - 20.workspace-configuration.4500.md
            - 30.module-configuration.4510.md
            - 35.namespace-configuration.4515.md
            - 40.environment-configuration.4520.md
            - 50.repository-policy-configuration.4530.md
            - actions/10.documentation-action.5100.md
            - actions/15.catalog-action.5170.md
            - actions/20.archive-action.5110.md
            - actions/30.changelog-action.5120.md
            - actions/40.git-release-action.5130.md
            - actions/50.version-bumper-action.5140.md
            - actions/60.ci-action.5150.md
            - actions/70.review-request-action.5160.md
          out: crates/evin/assets/config-catalog.json

  esh-catalog:
    stage: Docs
    description: "Generate the tracked ESH runtime catalog intentionally"
    needs: [main:build]
    steps:
      - uses: evin/catalog@v1
        with:
          source_dir: docs/reference/esh
          include: [100.runtime-reference.3010.md]
          out: crates/esh/assets/builtins-catalog.json

  build:
    stage: Docs
    description: "Generate framework-neutral documentation data and validate routes"
    needs: [main:build]
    on:
      hooks: [pre-commit]
    steps:
      - uses: evin/docs@v1
        with:
          source_dir: docs
          out: dist/docs-data
          exclude: [esh-posix-compatibility-report.md]
          strict_filenames: true
          versions:
            - id: v0.2.4
              source_dir: docs
            - id: v0.3.0
              source_dir: docs
          latest_version: v0.3.0
