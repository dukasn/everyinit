# Version bumper plugin locale messages

stable-and-prerelease-conflict = stable and prerelease cannot be used together
stable-and-channel-conflict = stable and channel cannot be used together
prerelease-and-channel-conflict = prerelease and channel cannot be used together
prerelease-must-not-be-empty = prerelease must not be empty
git-tag-requires-git-commit = git.tag requires git.commit
git-message-must-not-be-empty = git.message must not be empty
git-include-paths-must-not-be-empty = git.include paths must not be empty
file-path-must-not-be-empty = file path must not be empty
custom-file-path-must-not-be-empty = custom file path must not be empty
custom-file-match-must-not-be-empty = custom file match must not be empty
custom-file-write-must-not-be-empty = custom file write must not be empty
initial-version-invalid = initial_version must be valid SemVer: { $error }
prerelease-invalid = prerelease is invalid: { $error }
git-defer-requires-commit-and-tag = git.defer requires both git.commit and git.tag to be true
read-only-conflicts-with-mutations = read_only cannot be combined with file updates or Git mutation
fixed-version-invalid = fixed_version must be valid SemVer: { $error }
fixed-version-requires-read-only = fixed_version is only valid with read_only: true
automatic-version-detection-unsupported = automatic version detection is unsupported for '{ $path }'
custom-file-match-invalid = custom file match is invalid: { $error }
version-bumper-git-branch-resolution-failed = Failed to resolve git branch
version-bumper-git-branch-requirement = The {git.branch} variable requires a valid git branch.
version-bumper-workspace-name-resolution-failed = Failed to resolve workspace name
version-bumper-workspace-name-requirement = The {workspace.name} variable requires a configured workspace name.
version-bumper-channel-variable-location-hint = missing variable here
version-bumper-channel-undefined = Prerelease channel '{ $channel }' is not defined in policy.json
version-bumper-git-short-sha-resolution-failed = Failed to resolve git short SHA
version-bumper-git-short-sha-requirement = The {git.short_sha} variable requires a valid git commit.
version-bumper-environment-variable-missing = Missing required environment variable
version-bumper-environment-variable-required = The environment variable '{ $name }' is required by this template but is not set.
version-bumper-channel-variable-unknown = Unknown channel template variable '{ $name }'
version-bumper-fixed-version-resolution-invalid = fixed_version must resolve to valid SemVer: { $error }
version-bumper-package-policy-invalid = Invalid package release policy: { $error }
version-bumper-package-release-requires-git = package-managed releases require git.commit and git.tag to be true
