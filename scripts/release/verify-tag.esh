#!/usr/bin/env esh
set -e

assert [ "$#" -eq 2 ] "usage: verify-tag.esh <tag> <version>"
TAG="$1"
VERSION="$2"
WORKSPACE_VERSION=$(grep -F "version = " Cargo.toml | head -n 1 | cut -d '"' -f 2)

assert [ -n "$WORKSPACE_VERSION" ] "workspace version could not be read from Cargo.toml"
assert [ "$TAG" = "v$WORKSPACE_VERSION" ] "tag $TAG does not match workspace version $WORKSPACE_VERSION"
assert [ "$VERSION" = "$WORKSPACE_VERSION" ] "release version $VERSION does not match workspace version $WORKSPACE_VERSION"
