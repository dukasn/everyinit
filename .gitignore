# Ignore everything in the root
/*

# Explicitly allow standard root files and directories
!/.gitignore
!/Cargo.toml
!/Cargo.lock
# Public repository entry point; the root deny-all rule otherwise excludes it.
!/README.md
!/docs/
!/crates/
!/.evin/
!/.github/
!/builtins/
!/locales/
!/CHANGELOG.md
!/LICENSE
!/package.json
!/package-lock.json
!/playwright.config.mjs
!/scripts/
!/tests/

# (progress.md and STACK.md remain excluded by the /* rule)

# Standard Rust & editor ignores for allowed directories
target/
node_modules/
__pycache__/
*.pyc
**/*.rs.bk
**/*.log
**/*.tmp
**/*.bak
**/*~
**/*.swp
**/.DS_Store
**/.evin/trace.json
**/.evin/build/
