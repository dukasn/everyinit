{
  "environments": {
    "RELEASE_TAG": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "scopes": [
        "Internal",
        "Process"
      ],
      "stages": [
        "Publish"
      ]
    },
    "RELEASE_TARGET": {
      "type": "string",
      "pattern": "^x86_64-unknown-linux-musl$",
      "scopes": [
        "Internal",
        "Process"
      ],
      "stages": [
        "Publish"
      ]
    },
    "RELEASE_VERSION": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "scopes": [
        "Internal",
        "Process"
      ],
      "stages": [
        "Publish"
      ]
    },
    "RELEASE_SIGNING_KEY_FILE": {
      "type": "string",
      "scopes": [
        "Internal",
        "Process"
      ],
      "stages": [
        "Publish"
      ]
    },
    "release_name": {
      "type": "string",
      "default": "evin",
      "scopes": [
        "Internal"
      ]
    }
  },
  "$schema": "https://dl.everyinit.dev/schema/v1/environment"
}
